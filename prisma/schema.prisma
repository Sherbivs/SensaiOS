// Prisma schema for Infinity Gauntlet — MVP entities
// Prisma 7 Configuration: Uses driver adapters (no Rust engine)
// NORTHSTAR OPTIMIZATION (2025-12-21): Full-text search indexes and optimized generator
generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  // OPTIMIZATION: Pre-generate all relation types for faster queries
  previewFeatures = ["fullTextSearchPostgres"]
}

// Database URL configured via prisma.config.ts for CLI operations
// Runtime connections use @prisma/adapter-pg in src/shared/prisma.ts
datasource db {
  provider = "postgresql"
}

/// ---- Dex Reference Enums ----
enum MoveCategory {
  physical
  special
  status
}

enum LearnMethod {
  level
  machine
  tutor
  egg
}

/// ---- Tenant & Trainer Core ----
model Tenant {
  id        String   @id
  createdAt DateTime @default(now())

  trainers        Trainer[]
  auditLog        AuditLog[]
  PokemonInstance PokemonInstance[]
  Encounter       Encounter[]
  Battle          Battle[]
}

model Trainer {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  nickname  String?
  createdAt DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings    TrainerSettings?
  mons        PokemonInstance[]
  encounters  Encounter[]
  battlesAsP1 Battle[]          @relation("BattleTrainer1")
  battlesAsP2 Battle[]          @relation("BattleTrainer2")
  parties     Party[]
  inventory   Inventory[]

  @@unique([tenantId, userId])
  @@index([userId])
  @@index([tenantId, createdAt(sort: Desc)], map: "idx_trainer_tenant_newest") // Newest trainers per tenant
}

model DexPack {
  packHash  String   @id
  schemaVer Int      @db.SmallInt
  gen       Int      @db.SmallInt
  signedAt  DateTime
  metaJson  Json

  trainerSettings TrainerSettings[]
  mons            PokemonInstance[]
  encounters      Encounter[]
  battles         Battle[]
  items           Item[]
}

model TrainerSettings {
  trainerId  String   @id
  activePack String
  prefsJson  Json
  updatedAt  DateTime @default(now())

  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  activeDex DexPack @relation(fields: [activePack], references: [packHash], onDelete: Restrict)
}

/// ---- Core Dex Tables ----
model Type {
  id   Int    @id @db.SmallInt
  slug String @unique
  name String

  moves        Move[]        @relation("MoveType")
  atk          TypeChart[]   @relation("AtkType")
  def          TypeChart[]   @relation("DefType")
  speciesTypes SpeciesType[]
}

model Ability {
  id   Int     @id @db.SmallInt
  slug String  @unique
  name String
  desc String?

  speciesAbilities SpeciesAbility[]
}

model Item {
  id       Int     @id @db.SmallInt
  slug     String  @unique
  name     String
  kind     String
  meta     Json?
  packHash String?

  learnsetUsages    SpeciesLearnset[] @relation("LearnsetMachine")
  evolutionTriggers EvolutionStep[]   @relation("EvolutionItem")
  dexPack           DexPack?          @relation(fields: [packHash], references: [packHash], onDelete: SetNull)
  Inventory         Inventory[]

  @@index([kind]) // Item category lookups (balls, potions, berries, etc.)
}

model Move {
  id       Int          @id @db.SmallInt
  slug     String       @unique
  name     String
  typeId   Int          @db.SmallInt
  type     Type         @relation("MoveType", fields: [typeId], references: [id])
  power    Int?         @db.SmallInt
  accuracy Int?         @db.SmallInt
  pp       Int          @db.SmallInt
  priority Int          @default(0) @db.SmallInt
  category MoveCategory
  meta     Json?

  learnset SpeciesLearnset[]

  @@index([typeId])
  @@index([name]) // Fast move name lookups
  @@index([category]) // Filter by physical/special/status
}

model Species {
  id          Int    @id @db.SmallInt
  slug        String @unique
  name        String
  baseHp      Int    @db.SmallInt
  baseAtk     Int    @db.SmallInt
  baseDef     Int    @db.SmallInt
  baseSpAtk   Int    @db.SmallInt
  baseSpDef   Int    @db.SmallInt
  baseSpe     Int    @db.SmallInt
  growth      String
  captureRate Int    @db.SmallInt
  maleRate    Int?   @db.SmallInt
  hatchSteps  Int?   @db.SmallInt
  meta        Json?

  types          SpeciesType[]
  abilities      SpeciesAbility[]
  learnset       SpeciesLearnset[]
  evolutionsFrom EvolutionStep[]   @relation("EvoFrom")
  evolutionsTo   EvolutionStep[]   @relation("EvoTo")
  mons           PokemonInstance[]
  encounters     Encounter[]

  @@index([slug])
  @@index([name]) // Fast name lookups for Pokedex search
}

/// ---- Classification / Junctions ----
model SpeciesType {
  speciesId Int @db.SmallInt
  typeId    Int @db.SmallInt
  slot      Int @db.SmallInt

  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  type    Type    @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@id([speciesId, slot])
  @@index([typeId])
}

model SpeciesAbility {
  speciesId Int @db.SmallInt
  abilityId Int @db.SmallInt
  slot      Int @db.SmallInt

  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  ability Ability @relation(fields: [abilityId], references: [id], onDelete: Restrict)

  @@id([speciesId, slot])
  @@index([abilityId])
}

model SpeciesLearnset {
  speciesId Int         @db.SmallInt
  moveId    Int         @db.SmallInt
  method    LearnMethod
  level     Int         @default(0) @db.SmallInt
  machineId Int?        @db.SmallInt

  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  move    Move    @relation(fields: [moveId], references: [id], onDelete: Cascade)
  machine Item?   @relation("LearnsetMachine", fields: [machineId], references: [id], onDelete: Restrict)

  @@id([speciesId, moveId, method, level])
  @@index([moveId])
  @@index([method, level])
}

model EvolutionStep {
  fromId  Int    @db.SmallInt
  toId    Int    @db.SmallInt
  trigger String
  level   Int?   @db.SmallInt
  itemId  Int?   @db.SmallInt
  meta    Json?

  from Species @relation("EvoFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Species @relation("EvoTo", fields: [toId], references: [id], onDelete: Cascade)
  item Item?   @relation("EvolutionItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@id([fromId, toId])
  @@index([toId])
}

model TypeChart {
  atkTypeId Int @db.SmallInt
  defTypeId Int @db.SmallInt
  mult      Int @db.SmallInt

  atkType Type @relation("AtkType", fields: [atkTypeId], references: [id], onDelete: Cascade)
  defType Type @relation("DefType", fields: [defTypeId], references: [id], onDelete: Cascade)

  @@id([atkTypeId, defTypeId])
  @@index([defTypeId])
}

model NameVariant {
  id         String @id @default(cuid())
  kind       String
  refIntId   Int    @db.SmallInt
  locale     String
  nameType   String
  value      String
  normalized String

  @@index([kind, refIntId])
  @@index([locale, normalized])
}

model User {
  id                      String             @id @default(cuid())
  discordId               String             @unique
  platformId              String?            @unique
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  coins                   Int                @default(0)
  settingsJson            Json?
  parties                 Party[]
  pokemon                 PokemonInstance[]
  encounters              Encounter[]
  battlesP1               Battle[]           @relation("BattlesAsP1")
  battlesP2               Battle[]           @relation("BattlesAsP2")
  cooldowns               Cooldown[]
  dailyQuestStreak        Int                @default(0)
  dailyQuestLastCompleted DateTime?
  dailyQuestLastReset     DateTime?
  trainers                Trainer[]
  homesteadChannels       HomesteadChannel[]

  @@index([dailyQuestStreak(sort: Desc)], map: "idx_user_streak_leaderboard") // Streak leaderboard
  @@index([coins(sort: Desc)], map: "idx_user_coins_leaderboard") // Wealth leaderboard
  @@index([createdAt(sort: Desc)], map: "idx_user_newest") // Recent players
}

/// ---- Homestead Channel (Private Guild Channel per User) ----
/// Enhanced schema supporting multi-guild, admin visibility, and operational metadata
model HomesteadChannel {
  id             String   @id @default(cuid())
  userId         String // User can have multiple homesteads (one per guild)
  guildId        String // Discord guild this homestead belongs to
  channelId      String   @unique // Discord channel snowflake
  createdAt      DateTime @default(now())
  lastAccessedAt DateTime @updatedAt

  // Operational metadata (Phase 2 enhancements)
  status              String    @default("active") // active | suspended | archived
  createdBy           String    @default("system") // system | admin | migration
  securityFingerprint String? // SHA-256 hash of creation context
  lastHealthCheck     DateTime? // Last verification timestamp
  verifiedAt          DateTime? // Last successful verification timestamp

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, guildId]) // One homestead per user per guild (multi-guild support)
  @@index([guildId]) // Fast guild-wide queries
  @@index([channelId]) // Fast channel → user lookup
  @@index([status]) // Filter by status
  @@index([lastHealthCheck]) // Find channels needing health check
  @@map("homestead_channels")
}

/// ---- Discord Identity Cache (Security Bot Data Pool) ----
/// Synced by security bot periodic sweeps - CANONICAL source for Discord identities

model DiscordGuild {
  id                String    @id @default(cuid())
  name              String // Guild name
  ownerId           String    @map("owner_id") // Owner's Discord user ID
  icon              String? // Icon hash
  memberCount       Int       @map("member_count") // Approximate member count
  roleCount         Int       @map("role_count") // Role count
  channelCount      Int       @map("channel_count") // Channel count
  monitoringEnabled Boolean   @default(true) @map("monitoring_enabled") // Security monitoring enabled
  lastSweepAt       DateTime? @map("last_sweep_at") @db.Timestamptz(6) // Last security sweep
  sweepCount        Int       @default(0) @map("sweep_count") // Total sweep count
  firstSeenAt       DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastUpdatedAt     DateTime  @default(now()) @map("last_updated_at") @db.Timestamptz(6)

  @@index([lastSweepAt(sort: Desc)], map: "idx_discord_guilds_last_sweep")
  @@index([monitoringEnabled], map: "idx_discord_guilds_monitoring")
  @@index([ownerId], map: "idx_discord_guilds_owner")
  @@map("discord_guilds")
}

model DiscordMember {
  id                         String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  discordUserId              String    @map("discord_user_id") // Discord user snowflake
  guildId                    String    @map("guild_id") // Discord guild snowflake
  username                   String // Current Discord username
  discriminator              String? // Legacy discriminator
  displayName                String?   @map("display_name") // Guild-specific nickname
  avatar                     String? // Avatar hash
  bot                        Boolean   @default(false) // Bot account flag
  roles                      String[]  @default([]) // Role IDs
  joinedAt                   DateTime? @map("joined_at") @db.Timestamptz(6) // Guild join timestamp
  premiumSince               DateTime? @map("premium_since") @db.Timestamptz(6) // Nitro boost timestamp
  pending                    Boolean   @default(false) // Pending membership
  communicationDisabledUntil DateTime? @map("communication_disabled_until") @db.Timestamptz(6)
  roleCount                  Int       @map("role_count") // Number of roles
  highestRolePosition        Int       @map("highest_role_position") // Highest role position
  isAdministrator            Boolean   @default(false) @map("is_administrator") // Has ADMINISTRATOR permission
  isOwner                    Boolean   @default(false) @map("is_owner") // Is guild owner
  lastActivityAt             DateTime? @map("last_activity_at") @db.Timestamptz(6) // Last activity timestamp
  securityFlags              String[]  @default([]) @map("security_flags") // Security flags
  riskScore                  Float?    @map("risk_score") // Security risk score (0.0-1.0)
  firstSeenAt                DateTime  @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastUpdatedAt              DateTime  @default(now()) @map("last_updated_at") @db.Timestamptz(6)

  @@unique([discordUserId, guildId]) // One entry per user per guild
  @@index([guildId], map: "idx_discord_members_guild") // CRITICAL: Guild sweeps (security bot)
  @@index([guildId, isAdministrator], map: "idx_discord_members_admin_lookup") // Admin queries
  @@index([riskScore(sort: Desc)], map: "idx_discord_members_risk") // High-risk user detection
  @@map("discord_members")
}

model PokemonInstance {
  id         String      @id @default(cuid())
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  speciesId  Int         @db.SmallInt
  species    Species     @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  form       String? // e.g., "alolan", "galarian"
  level      Int         @default(1)
  exp        Int         @default(0)
  nature     String?
  ivsJson    Json // {hp, atk, def, spa, spd, spe}
  evsJson    Json // same shape
  movesJson  Json // array of {id, pp, maxPP}
  status     String? // major status (burn, para, etc.)
  hp         Int
  maxHp      Int
  isShiny    Boolean     @default(false)
  nickname   String?
  boxSlot    Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tenantId   String?
  trainerId  String?
  packHash   String?
  partySlots PartySlot[]

  // Trading fields (OT = Original Trainer)
  originalTrainerId String? // Discord ID of who first caught/received this Pokémon
  tradedAt          DateTime? // When this Pokémon was last traded (null = never traded)

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  dexPack DexPack? @relation(fields: [packHash], references: [packHash], onDelete: SetNull)

  @@index([ownerId])
  @@index([speciesId])
  @@index([trainerId])
  @@index([tenantId])
  @@index([ownerId, createdAt(sort: Desc)], map: "idx_pokemon_owner_created") // Recent Pokemon
  @@index([ownerId, isShiny], map: "idx_pokemon_owner_shiny") // Shiny collection
  @@index([ownerId, level(sort: Desc)], map: "idx_pokemon_owner_level") // Strongest Pokemon
}

model Party {
  id        String      @id @default(cuid())
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  trainerId String?
  slots     PartySlot[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@unique([ownerId])
  @@index([ownerId])
  @@index([trainerId])
}

model PartySlot {
  id        String          @id @default(cuid())
  party     Party           @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId   String
  slot      Int
  pokemon   PokemonInstance @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  pokemonId String
  updatedAt DateTime        @updatedAt

  @@unique([partyId, slot])
  @@unique([pokemonId])
  @@index([partyId])
}

model Inventory {
  trainerId String
  itemId    Int    @db.SmallInt
  qty       Int    @default(0)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([trainerId, itemId])
  @@index([itemId])
}

model Encounter {
  id              String    @id @default(cuid())
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String
  speciesId       Int       @db.SmallInt
  species         Species   @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  level           Int
  state           String // Idle|Spawned|Caught|Fled|Fainted|Expired
  threadChannelId String?
  startedAt       DateTime  @default(now())
  expiresAt       DateTime?
  dataJson        Json?
  tenantId        String?
  trainerId       String?
  packHash        String?

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  dexPack DexPack? @relation(fields: [packHash], references: [packHash], onDelete: SetNull)

  @@index([ownerId, state])
  @@index([state, startedAt(sort: Desc)], map: "idx_encounter_state_time") // Recent by state
  @@index([threadChannelId])
  @@index([expiresAt])
  @@index([tenantId, startedAt(sort: Desc)], map: "idx_encounter_tenant_time") // Tenant timeline
  @@index([ownerId, startedAt(sort: Desc)], map: "idx_encounter_owner_time") // User timeline
}

model Battle {
  id            String    @id @default(cuid())
  p1            User      @relation("BattlesAsP1", fields: [p1Id], references: [id])
  p1Id          String
  p2            User      @relation("BattlesAsP2", fields: [p2Id], references: [id])
  p2Id          String
  arenaThreadId String?
  state         String // Pending|Active|Finished|Aborted
  rngSeed       String
  ruleset       String
  logCompact    Json?
  logFull       Json?
  resultJson    Json?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  updatedAt     DateTime  @updatedAt
  tenantId      String?
  packHash      String?
  trainer1Id    String?
  trainer2Id    String?

  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  dexPack  DexPack? @relation(fields: [packHash], references: [packHash], onDelete: SetNull)
  trainer1 Trainer? @relation("BattleTrainer1", fields: [trainer1Id], references: [id], onDelete: SetNull)
  trainer2 Trainer? @relation("BattleTrainer2", fields: [trainer2Id], references: [id], onDelete: SetNull)

  @@index([state, endedAt(sort: Desc)], map: "idx_battle_state_ended") // Active/recent battles
  @@index([p1Id, state, endedAt(sort: Desc)], map: "idx_battle_p1_history") // Player 1 history
  @@index([p2Id, state, endedAt(sort: Desc)], map: "idx_battle_p2_history") // Player 2 history
  @@index([arenaThreadId])
  @@index([tenantId, state, endedAt(sort: Desc)], map: "idx_battle_tenant_history") // Tenant history
}

model Cooldown {
  id        String   @id @default(cuid())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  kind      String // e.g., "walk", "battle", etc.
  readyAt   DateTime
  metaJson  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, kind])
  @@index([ownerId, readyAt(sort: Asc)], map: "idx_cooldown_owner_ready") // Next available action
  @@index([kind, readyAt], map: "idx_cooldown_kind_ready") // Cooldown type queries
}

enum BusKind {
  event
  command
}

enum BusStatus {
  pending
  processing
  done
  error
}

enum BusPriority {
  high
  normal
  low
}

model BusMessage {
  id             String      @id @default(cuid())
  kind           BusKind     @default(event)
  topic          String
  priority       BusPriority @default(normal)
  shardKey       String?
  idempotencyKey String
  payload        Json
  createdAt      DateTime    @default(now())
  availableAt    DateTime    @default(now())
  status         BusStatus   @default(pending)
  attempts       Int         @default(0)
  error          String?
  processedAt    DateTime?
  updatedAt      DateTime    @updatedAt

  // === SENSAI EVOLUTION (2025-12-28) ===
  // Monotonic sequence for stable ordering (replaces timestamp-based pagination)
  seq            BigInt    @default(autoincrement())
  // Schema versioning for payload evolution (future-proofing)
  schemaVersion  Int       @default(1) @map("schema_version")
  // Scheduled retry support (replaces immediate availableAt updates)
  nextAttemptAt  DateTime? @map("next_attempt_at")
  // Dead letter queue tracking (failed messages after max attempts)
  deadLetteredAt DateTime? @map("dead_lettered_at")
  // Partition key for sharded processing (entity-level serialization)
  partitionKey   String?   @map("partition_key")

  @@unique([topic, idempotencyKey])
  @@unique([seq])
  @@index([status, availableAt, priority])
  @@index([topic, status, availableAt])
  @@index([shardKey, status])
  @@index([seq]) // Monotonic ordering for projection workers
  @@index([status, nextAttemptAt, priority]) // Scheduled retry queries
  @@index([partitionKey, status]) // Sharded processing
}

model BusIdemToken {
  key       String   @id
  createdAt DateTime @default(now())
  ttl       Int      @default(604800)
}

/// ---- SENSAI: Export Log (Layer 2) ----
/// Append-only event log - the single source of truth for all external inputs
/// Replaces fragmented event systems with unified ingestion front door
model Export {
  id                  String   @id @default(cuid())
  seq                 BigInt   @unique @default(autoincrement())
  source              String // 'discord' | 'worker' | 'admin' | component name
  type                String // 'player.action.walk' | 'battle.completed'
  schemaVersion       Int      @default(1) @map("schema_version")
  idempotencyKey      String   @map("idempotency_key")
  payload             Json
  occurredAt          DateTime @map("occurred_at")
  createdAt           DateTime @default(now()) @map("created_at")
  correlationId       String   @map("correlation_id")
  parentCorrelationId String?  @map("parent_correlation_id")
  signature           String? // Optional HMAC for tamper resistance

  @@unique([source, type, idempotencyKey])
  @@index([seq])
  @@index([type, seq])
  @@index([source, seq])
  @@index([correlationId])
  @@index([occurredAt])
  @@map("exports")
}

/// Schema registry for export type evolution
model ExportTypeRegistry {
  type           String   @id
  currentVersion Int      @map("current_version")
  jsonSchema     Json?    @map("json_schema")
  deprecated     Boolean  @default(false)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("export_type_registry")
}

/// Worker projection offset tracking (seq-based checkpointing)
model ProjectionOffset {
  projectionName String   @id @map("projection_name")
  lastSeq        BigInt   @default(0) @map("last_seq")
  lastProcessed  DateTime @default(now()) @map("last_processed")
  workerVersion  String?  @map("worker_version")

  @@map("projection_offsets")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  at          DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, at])
}

/// ---- Database Replication Tracking ----
model DbVersion {
  id                     Int      @id @default(autoincrement())
  versionFingerprint     String
  migrationCount         Int
  lastMigrationName      String
  lastMigrationAppliedAt DateTime
  syncSource             String?
  createdAt              DateTime @default(now())

  @@index([versionFingerprint])
  @@map("db_version")
}

model DbSyncState {
  id                 Int       @id @default(autoincrement())
  source             String
  target             String
  status             String
  lastSyncAt         DateTime?
  lastDuration       Int?
  lastError          String?
  lastIntegrityCheck Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([source, target])
  @@index([status])
  @@map("db_sync_state")
}

/// ---- Log Ingestion System (TimescaleDB Hypertable) ----
/// Centralized log storage for Event Bus logs, service logs, and monitoring data
/// Note: This is a TimescaleDB hypertable with composite primary key
model LogEntry {
  id            BigInt   @default(autoincrement())
  timestamp     DateTime @db.Timestamptz(6)
  level         String // info, warn, error, debug
  category      String // battle, encounter, security, system, etc.
  message       String?  @db.Text // Log message content
  metadata      Json? // Additional structured data
  correlationId String?  @map("correlation_id") @db.Uuid // Request/operation tracking
  serviceName   String?  @map("service_name") // Origin service (bot, worker, etc.)
  userId        String?  @map("user_id") // Associated user if applicable
  traceContext  String?  @map("trace_context") // Distributed tracing context
  component     String? // Component name for filtering
  operation     String? // Operation name for tracing
  durationMs    Int?     @map("duration_ms") // Operation duration in milliseconds

  @@id([id, timestamp]) // Composite key required by TimescaleDB
  @@index([category, timestamp(sort: Desc)], map: "idx_log_category_time")
  @@index([correlationId], map: "idx_log_correlation")
  @@index([level, component, timestamp(sort: Desc)], map: "idx_log_entries_level_component")
  @@index([level, timestamp(sort: Desc)], map: "idx_log_level_time")
  @@map("log_entries")
}

/// ---- Error Detection & Learning System ----
model ErrorLog {
  errorId     String @id @default(uuid())
  fingerprint String @unique
  category    String
  severity    String

  // Occurrence tracking
  firstSeen       DateTime @default(now())
  lastSeen        DateTime @default(now())
  occurrenceCount Int      @default(1)

  // Error details
  errorName    String
  errorMessage String  @db.Text
  stackTrace   String? @db.Text

  // Context (JSONB for flexibility)
  contextData Json?

  // Recovery tracking
  recoveryAttempted    Int     @default(0)
  recoverySuccess      Int     @default(0)
  lastRecoveryStrategy String?
  lastRecoveryOutcome  String?

  // Impact assessment
  impactedFeatures    String[]
  estimatedUserImpact Int?

  // Learning metadata (JSONB for ML features)
  learningMetadata Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  alerts         ErrorAlert[]
  resolutions    ErrorResolution[]
  codeContexts   ErrorCodeContext[]
  parentCascades ErrorDependency[]  @relation("ParentCascade")
  childCascades  ErrorDependency[]  @relation("ChildCascade")

  @@index([fingerprint])
  @@index([category])
  @@index([severity])
  @@index([lastSeen(sort: Desc)])
  @@index([occurrenceCount(sort: Desc)])
  @@map("ErrorLog")
}

model ErrorAlert {
  alertId        String    @id @default(uuid())
  errorId        String
  alertType      String
  recipientId    String?
  sentAt         DateTime  @default(now())
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?

  error ErrorLog @relation(fields: [errorId], references: [errorId], onDelete: Cascade)

  @@index([errorId])
  @@index([sentAt(sort: Desc)])
  @@map("ErrorAlert")
}

/// ---- Error Learning System (Phase 1) ----
/// Specialist Team Design Session — December 21, 2025
/// Enables ML pattern detection, resolution tracking, and cascade analysis

/// ErrorKnowledge — Stores learned patterns separately from errors
/// Patterns expire and refresh via ErrorLearningWorker
model ErrorKnowledge {
  knowledgeId String @id @default(uuid())
  patternType String // 'TIME_CLUSTER' | 'CORRELATION' | 'CASCADE' | 'RECOVERY'

  // Pattern data (flexible JSONB for ML features)
  patternData Json

  // Confidence and validity
  confidence    Float // 0.0 to 1.0
  validUntil    DateTime // Patterns expire and need refresh
  observedCount Int      @default(1) // How many times pattern observed

  // Related errors (optional fingerprints)
  relatedFingerprints String[] // Fingerprints involved in this pattern

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patternType, confidence(sort: Desc)])
  @@index([validUntil])
  @@index([patternType, validUntil])
  @@map("ErrorKnowledge")
}

/// ErrorResolution — Tracks fix attempts and outcomes for learning
/// Enables "what worked before" queries and success rate calculation
model ErrorResolution {
  resolutionId String @id @default(uuid())
  errorId      String

  // Resolution details
  strategy   String // 'RETRY' | 'FALLBACK' | 'RESTART' | 'ESCALATE' | 'IGNORE'
  attempted  DateTime @default(now())
  durationMs Int? // How long the resolution took

  // Outcome tracking
  outcome String // 'SUCCESS' | 'PARTIAL' | 'FAILED' | 'ESCALATED'

  // Context and notes
  notes       String? @db.Text // AI-generated or human notes
  contextData Json? // Additional context at resolution time

  // Who/what triggered resolution
  triggeredBy String? // 'AUTO' | 'MANUAL' | userId

  // Relation to error
  error ErrorLog @relation(fields: [errorId], references: [errorId], onDelete: Cascade)

  @@index([errorId, outcome])
  @@index([strategy, outcome])
  @@index([attempted(sort: Desc)])
  @@index([strategy, attempted(sort: Desc)])
  @@map("ErrorResolution")
}

/// ErrorDependency — Tracks which errors trigger other errors
/// Enables root cause analysis and cascade prediction
model ErrorDependency {
  dependencyId String @id @default(uuid())

  // Parent = root cause, Child = cascaded error
  parentErrorId String
  childErrorId  String

  // Statistical tracking
  observedCount  Int   @default(1) // How many times this cascade observed
  avgTimeDeltaMs Float @default(0) // Average ms between parent→child
  confidence     Float @default(0) // 0.0 to 1.0 confidence score

  // Timestamps
  firstObserved DateTime @default(now())
  lastObserved  DateTime @default(now())

  // Relations
  parentError ErrorLog @relation("ParentCascade", fields: [parentErrorId], references: [errorId], onDelete: Cascade)
  childError  ErrorLog @relation("ChildCascade", fields: [childErrorId], references: [errorId], onDelete: Cascade)

  @@unique([parentErrorId, childErrorId])
  @@index([parentErrorId])
  @@index([childErrorId])
  @@index([confidence(sort: Desc)])
  @@map("ErrorDependency")
}

/// ErrorCodeContext — Preserves stack frame details for debugging
/// Enables "show me where this error occurred" queries
model ErrorCodeContext {
  contextId String @id @default(uuid())
  errorId   String

  // Stack frame details
  frameIndex   Int // 0 = top of stack
  filePath     String
  lineNumber   Int
  columnNumber Int?
  functionName String?

  // Code snippet (5 lines around error)
  codeSnippet String? @db.Text

  // Relation to error
  error ErrorLog @relation(fields: [errorId], references: [errorId], onDelete: Cascade)

  @@index([errorId])
  @@index([filePath, lineNumber])
  @@index([functionName])
  @@map("ErrorCodeContext")
}

