  createdAt DateTime @default(now()) @map("created_at")

  @@unique([boardType, weekOf])
  @@index([boardType], map: "idx_snapshot_type")
  @@index([weekOf(sort: Desc)], map: "idx_snapshot_week")
  @@map("leaderboard_snapshots")
}

// ============================================================================
// /Store Write Elimination - Database-First Architecture (2025-12-27)
// ============================================================================
// These tables replace file writes to /Store directory
// Reference: docs/projects/STORE-WRITE-ELIMINATION.md
// Note: Cooldown model already exists above (lines 508-521)
// ============================================================================

/// Runtime metrics (replaces /Store/restart-metrics.json)
model RuntimeMetric {
  id           String   @id @default(cuid())
  metricType   String   @map("metric_type") // 'restart', 'crash', 'shutdown'
  timestamp    DateTime @default(now())
  trigger      String? // SIGTERM, SIGINT, EXIT, PM2_RESTART, etc.
  uptimeMs     BigInt?  @map("uptime_ms")
  errorMessage String?  @map("error_message")
  stackTrace   String?  @map("stack_trace")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([metricType, timestamp(sort: Desc)], map: "idx_runtime_metric_type_time")
  @@map("runtime_metrics")
}

/// Alert queue (replaces /Store/alerts/)
model AlertQueue {
  id            String    @id @default(cuid())
  alertId       String    @map("alert_id")
  alertType     String    @map("alert_type")
  level         String // 'EMERGENCY', 'CRITICAL', 'WARNING', 'INFO'
  message       String
  source        String?
  correlationId String?   @map("correlation_id")
  payload       Json?
  routedChannel Boolean   @default(false) @map("routed_channel")
  routedDm      Boolean   @default(false) @map("routed_dm")
  processed     Boolean   @default(false)
  processedAt   DateTime? @map("processed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([createdAt(sort: Desc)], map: "idx_alert_created")
  @@index([processed, createdAt], map: "idx_alert_pending")
  @@map("alert_queue")
}

/// Guild configuration (replaces /Store/guild-member-timeout-config.json)
model GuildConfig {
  guildId     String   @id @map("guild_id")
  configKey   String   @map("config_key")
  configValue Json     @map("config_value")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([configKey], map: "idx_guild_config_key")
  @@map("guild_config")
}

/// Cache entries (replaces /Store/runtime-cache/, /Store/discord-cache/, /Store/pokemon-cache/)
model CacheEntry {
  key            String    @id @map("cache_key")
  namespace      String
  value          Json
  sizeBytes      Int       @default(0) @map("size_bytes")
  accessCount    Int       @default(0) @map("access_count")
  lastAccessedAt DateTime? @map("last_accessed_at")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  @@index([namespace], map: "idx_cache_namespace")
  @@index([expiresAt], map: "idx_cache_expires")
  @@index([lastAccessedAt], map: "idx_cache_access")
  @@map("cache_entries")
}

/// ---- SENSAI: Control Plane (Component Management) ----

enum ComponentScopeType {
  global // System-wide installation
  host // Per-service (bot, worker, cron)
  guild // Per Discord guild
}

enum ComponentStatus {
  installed
  enabled
  disabled
  failed
}

enum HostKind {
  bot
  worker
  cron
  cli
}

/// Component installations (what's installed where)
model ComponentInstallation {
  id           String             @id @default(cuid())
  name         String // 'security.guard', 'system.cache-refresh'
  version      String // Semver: '1.2.3'
  scopeType    ComponentScopeType @map("scope_type")
  scopeId      String?            @map("scope_id") // hostId, guildId, or NULL for global
  status       ComponentStatus    @default(installed)
  manifestJson Json               @map("manifest_json") // Full SensaiComponent manifest
  installedAt  DateTime           @default(now()) @map("installed_at")
  enabledAt    DateTime?          @map("enabled_at")
  disabledAt   DateTime?          @map("disabled_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  @@unique([name, scopeType, scopeId])
  @@index([name, status])
  @@index([scopeType, scopeId])
  @@map("component_installations")
}

/// Component configuration (per-scope)
model ComponentConfig {
  id        String   @id @default(cuid())
  component String // Component name
  scopeType String   @map("scope_type") // 'global' | 'host' | 'guild'
  scopeId   String?  @map("scope_id")
  key       String // Config key
  value     Json // Config value
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([component, scopeType, scopeId, key])
  @@index([component])
  @@map("component_config")
}

/// Host registry (service discovery)
model Host {
  id            String    @id @default(cuid())
  hostId        String    @unique @map("host_id") // 'bot-1', 'worker-cache'
  kind          HostKind
  version       String // App version
  labelsJson    Json?     @map("labels_json") // Custom metadata
  startedAt     DateTime  @default(now()) @map("started_at")
  lastHeartbeat DateTime  @default(now()) @map("last_heartbeat")
  stoppedAt     DateTime? @map("stopped_at")

  @@index([kind, lastHeartbeat])
  @@map("hosts")
}

/// Worker run tracking (execution history)
model WorkerRun {
  id           String    @id @default(cuid())
  workerKind   String    @map("worker_kind") // 'PROJECT_DASHBOARD', 'DELIVER_MESSAGE'
  hostId       String?   @map("host_id")
  inputRefs    Json?     @map("input_refs") // References to inputs (export IDs, etc.)
  outputRefs   Json?     @map("output_refs") // References to outputs
  codeVersion  String?   @map("code_version")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  status       String // 'running', 'success', 'failed'
  errorMessage String?   @map("error_message")

  @@index([workerKind, startedAt])
  @@index([hostId, startedAt])
  @@map("worker_runs")
}

/// Capability grants (RBAC permissions)
model CapabilityGrant {
  id         String   @id @default(cuid())
  component  String // Component name
  capability String // 'db.write', 'discord.send', etc.
  scopeType  String   @map("scope_type")
  scopeId    String?  @map("scope_id")
  grantedAt  DateTime @default(now()) @map("granted_at")
  grantedBy  String   @map("granted_by") // Admin user ID

  @@unique([component, capability, scopeType, scopeId])
  @@index([component])
  @@map("capability_grants")
}
