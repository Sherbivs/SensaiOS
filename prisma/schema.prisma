// Prisma schema for Infinity Gauntlet — MVP entities
// Prisma 7: Using new prisma-client provider with driver adapters
// Database URL configured in prisma.config.ts (for CLI) and src/shared/prisma.ts (for runtime)
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// ---- Dex Reference Enums ----
enum MoveCategory {
  physical
  special
  status
}

enum LearnMethod {
  level
  machine
  tutor
  egg
}

/// ---- Tenant & Trainer Core ----
model Tenant {
  id        String   @id
  createdAt DateTime @default(now())

  trainers        Trainer[]
  auditLog        AuditLog[]
  PokemonInstance PokemonInstance[]
  Encounter       Encounter[]
  Battle          Battle[]
}

model Trainer {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  nickname  String?
  createdAt DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  settings    TrainerSettings?
  mons        PokemonInstance[]
  encounters  Encounter[]
  battlesAsP1 Battle[]          @relation("BattleTrainer1")
  battlesAsP2 Battle[]          @relation("BattleTrainer2")
  parties     Party[]
  inventory   Inventory[]

  @@unique([tenantId, userId])
  @@index([userId])
}

model DexPack {
  packHash  String   @id
  schemaVer Int      @db.SmallInt
  gen       Int      @db.SmallInt
  signedAt  DateTime
  metaJson  Json

  trainerSettings TrainerSettings[]
  mons            PokemonInstance[]
  encounters      Encounter[]
  battles         Battle[]
  items           Item[]
}

model TrainerSettings {
  trainerId  String   @id
  activePack String
  prefsJson  Json
  updatedAt  DateTime @default(now())

  trainer   Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  activeDex DexPack @relation(fields: [activePack], references: [packHash], onDelete: Restrict)
}

/// ---- Core Dex Tables ----
model Type {
  id   Int    @id @db.SmallInt
  slug String @unique
  name String

  moves        Move[]        @relation("MoveType")
  atk          TypeChart[]   @relation("AtkType")
  def          TypeChart[]   @relation("DefType")
  speciesTypes SpeciesType[]
}

model Ability {
  id   Int     @id @db.SmallInt
  slug String  @unique
  name String
  desc String?

  speciesAbilities SpeciesAbility[]
}

model Item {
  id       Int     @id @db.SmallInt
  slug     String  @unique
  name     String
  kind     String
  meta     Json?
  packHash String?

  learnsetUsages    SpeciesLearnset[] @relation("LearnsetMachine")
  evolutionTriggers EvolutionStep[]   @relation("EvolutionItem")
  dexPack           DexPack?          @relation(fields: [packHash], references: [packHash], onDelete: SetNull)
  Inventory         Inventory[]
}

model Move {
  id       Int          @id @db.SmallInt
  slug     String       @unique
  name     String
  typeId   Int          @db.SmallInt
  type     Type         @relation("MoveType", fields: [typeId], references: [id])
  power    Int?         @db.SmallInt
  accuracy Int?         @db.SmallInt
  pp       Int          @db.SmallInt
  priority Int          @default(0) @db.SmallInt
  category MoveCategory
  meta     Json?

  learnset SpeciesLearnset[]

  @@index([typeId])
}

model Species {
  id          Int    @id @db.SmallInt
  slug        String @unique
  name        String
  baseHp      Int    @db.SmallInt
  baseAtk     Int    @db.SmallInt
  baseDef     Int    @db.SmallInt
  baseSpAtk   Int    @db.SmallInt
  baseSpDef   Int    @db.SmallInt
  baseSpe     Int    @db.SmallInt
  growth      String
  captureRate Int    @db.SmallInt
  maleRate    Int?   @db.SmallInt
  hatchSteps  Int?   @db.SmallInt
  meta        Json?

  types          SpeciesType[]
  abilities      SpeciesAbility[]
  learnset       SpeciesLearnset[]
  evolutionsFrom EvolutionStep[]   @relation("EvoFrom")
  evolutionsTo   EvolutionStep[]   @relation("EvoTo")
  mons           PokemonInstance[]
  encounters     Encounter[]

  // Note: @unique on slug already creates an index (Species_slug_key)
  // Removed redundant @@index([slug]) - see migration 20251203043000
}

/// ---- Classification / Junctions ----
model SpeciesType {
  speciesId Int @db.SmallInt
  typeId    Int @db.SmallInt
  slot      Int @db.SmallInt

  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  type    Type    @relation(fields: [typeId], references: [id], onDelete: Restrict)

  @@id([speciesId, slot])
  @@index([typeId])
}

model SpeciesAbility {
  speciesId Int @db.SmallInt
  abilityId Int @db.SmallInt
  slot      Int @db.SmallInt

  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  ability Ability @relation(fields: [abilityId], references: [id], onDelete: Restrict)

  @@id([speciesId, slot])
  @@index([abilityId])
}

model SpeciesLearnset {
  speciesId Int         @db.SmallInt
  moveId    Int         @db.SmallInt
  method    LearnMethod
  level     Int         @default(0) @db.SmallInt
  machineId Int?        @db.SmallInt

  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  move    Move    @relation(fields: [moveId], references: [id], onDelete: Cascade)
  machine Item?   @relation("LearnsetMachine", fields: [machineId], references: [id], onDelete: Restrict)

  @@id([speciesId, moveId, method, level])
  @@index([moveId])
  @@index([method, level])
}

model EvolutionStep {
  fromId  Int    @db.SmallInt
  toId    Int    @db.SmallInt
  trigger String
  level   Int?   @db.SmallInt
  itemId  Int?   @db.SmallInt
  meta    Json?

  from Species @relation("EvoFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Species @relation("EvoTo", fields: [toId], references: [id], onDelete: Cascade)
  item Item?   @relation("EvolutionItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@id([fromId, toId])
  @@index([toId])
}

model TypeChart {
  atkTypeId Int @db.SmallInt
  defTypeId Int @db.SmallInt
  mult      Int @db.SmallInt

  atkType Type @relation("AtkType", fields: [atkTypeId], references: [id], onDelete: Cascade)
  defType Type @relation("DefType", fields: [defTypeId], references: [id], onDelete: Cascade)

  @@id([atkTypeId, defTypeId])
  @@index([defTypeId])
}

model NameVariant {
  id         String @id @default(cuid())
  kind       String
  refIntId   Int    @db.SmallInt
  locale     String
  nameType   String
  value      String
  normalized String

  @@index([kind, refIntId])
  @@index([locale, normalized])
}

model User {
  id                      String             @id @default(cuid())
  discordId               String             @unique
  platformId              String?            @unique
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  coins                   Int                @default(0)
  settingsJson            Json?
  parties                 Party[]
  pokemon                 PokemonInstance[]
  encounters              Encounter[]
  battlesP1               Battle[]           @relation("BattlesAsP1")
  battlesP2               Battle[]           @relation("BattlesAsP2")
  cooldowns               Cooldown[]
  dailyQuestStreak        Int                @default(0)
  dailyQuestLastCompleted DateTime?
  dailyQuestLastReset     DateTime?
  trainers                Trainer[]
  homesteadChannels       HomesteadChannel[]
}

/// ---- Homestead Channel (Private Guild Channel per User) ----
model HomesteadChannel {
  id             String   @id @default(cuid())
  userId         String   @unique
  guildId        String
  channelId      String   @unique
  createdAt      DateTime @default(now())
  lastAccessedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([channelId])
  @@map("homestead_channels")
}

model PokemonInstance {
  id         String      @id @default(cuid())
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  speciesId  Int         @db.SmallInt
  species    Species     @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  form       String? // e.g., "alolan", "galarian"
  level      Int         @default(1)
  exp        Int         @default(0)
  nature     String?
  ivsJson    Json // {hp, atk, def, spa, spd, spe}
  evsJson    Json // same shape
  movesJson  Json // array of {id, pp, maxPP}
  status     String? // major status (burn, para, etc.)
  hp         Int
  maxHp      Int
  isShiny    Boolean     @default(false)
  nickname   String?
  boxSlot    Int?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  tenantId   String?
  trainerId  String?
  packHash   String?
  partySlots PartySlot[]

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  dexPack DexPack? @relation(fields: [packHash], references: [packHash], onDelete: SetNull)

  @@index([ownerId])
  @@index([speciesId])
  @@index([trainerId])
  @@index([tenantId])
}

model Party {
  id        String      @id @default(cuid())
  owner     User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  trainerId String?
  slots     PartySlot[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@unique([ownerId])
  // Note: @@unique on ownerId already creates an index (Party_ownerId_key)
  // Removed redundant @@index([ownerId]) - see migration 20251203043000
  @@index([trainerId])
}

model PartySlot {
  id        String          @id @default(cuid())
  party     Party           @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId   String
  slot      Int
  pokemon   PokemonInstance @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  pokemonId String
  updatedAt DateTime        @updatedAt

  @@unique([partyId, slot])
  @@unique([pokemonId])
  @@index([partyId])
}

model Inventory {
  trainerId String
  itemId    Int    @db.SmallInt
  qty       Int    @default(0)

  trainer Trainer @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  item    Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@id([trainerId, itemId])
  @@index([itemId])
}

model Encounter {
  id              String    @id @default(cuid())
  owner           User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId         String
  speciesId       Int       @db.SmallInt
  species         Species   @relation(fields: [speciesId], references: [id], onDelete: Restrict)
  level           Int
  state           String // Idle|Spawned|Caught|Fled|Fainted|Expired
  threadChannelId String?
  startedAt       DateTime  @default(now())
  expiresAt       DateTime?
  dataJson        Json?
  tenantId        String?
  trainerId       String?
  packHash        String?

  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  dexPack DexPack? @relation(fields: [packHash], references: [packHash], onDelete: SetNull)

  @@index([ownerId, state])
  @@index([state, startedAt])
  @@index([threadChannelId])
  @@index([expiresAt])
  @@index([tenantId, startedAt])
}

model Battle {
  id            String    @id @default(cuid())
  p1            User      @relation("BattlesAsP1", fields: [p1Id], references: [id])
  p1Id          String
  p2            User      @relation("BattlesAsP2", fields: [p2Id], references: [id])
  p2Id          String
  arenaThreadId String?
  state         String // Pending|Active|Finished|Aborted
  rngSeed       String
  ruleset       String
  logCompact    Json?
  logFull       Json?
  resultJson    Json?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  updatedAt     DateTime  @updatedAt
  tenantId      String?
  packHash      String?
  trainer1Id    String?
  trainer2Id    String?

  tenant   Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  dexPack  DexPack? @relation(fields: [packHash], references: [packHash], onDelete: SetNull)
  trainer1 Trainer? @relation("BattleTrainer1", fields: [trainer1Id], references: [id], onDelete: SetNull)
  trainer2 Trainer? @relation("BattleTrainer2", fields: [trainer2Id], references: [id], onDelete: SetNull)

  @@index([state, endedAt])
  @@index([p1Id, state, endedAt])
  @@index([p2Id, state, endedAt])
  @@index([arenaThreadId])
  @@index([tenantId, state, endedAt])
}

model Cooldown {
  id        String   @id @default(cuid())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  kind      String // e.g., "walk", "battle", etc.
  readyAt   DateTime
  metaJson  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, kind])
  @@index([ownerId, readyAt])
}

enum BusKind {
  event
  command
}

enum BusStatus {
  pending
  processing
  done
  error
}

enum BusPriority {
  high
  normal
  low
}

model BusMessage {
  id             String      @id @default(cuid())
  kind           BusKind     @default(event)
  topic          String
  priority       BusPriority @default(normal)
  shardKey       String?
  idempotencyKey String
  payload        Json
  createdAt      DateTime    @default(now())
  availableAt    DateTime    @default(now())
  status         BusStatus   @default(pending)
  attempts       Int         @default(0)
  error          String?
  processedAt    DateTime?
  updatedAt      DateTime    @updatedAt

  @@unique([topic, idempotencyKey])
  @@index([status, availableAt, priority])
  @@index([topic, status, availableAt])
  @@index([shardKey, status])
}

model BusIdemToken {
  key       String   @id
  createdAt DateTime @default(now())
  ttl       Int      @default(604800)
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String?
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  beforeJson  Json?
  afterJson   Json?
  at          DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId, at])
}

/// ---- Database Replication Tracking ----
model DbVersion {
  id                     Int      @id @default(autoincrement())
  versionFingerprint     String
  migrationCount         Int
  lastMigrationName      String
  lastMigrationAppliedAt DateTime
  syncSource             String?
  createdAt              DateTime @default(now())

  @@index([versionFingerprint])
  @@map("db_version")
}

model DbSyncState {
  id                 Int       @id @default(autoincrement())
  source             String
  target             String
  status             String
  lastSyncAt         DateTime?
  lastDuration       Int?
  lastError          String?
  lastIntegrityCheck Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([source, target])
  @@index([status])
  @@map("db_sync_state")
}

/// ---- Error Detection & Learning System ----
model ErrorLog {
  errorId     String @id @default(uuid())
  fingerprint String @unique
  category    String
  severity    String

  // Occurrence tracking
  firstSeen       DateTime @default(now())
  lastSeen        DateTime @default(now())
  occurrenceCount Int      @default(1)

  // Error details
  errorName    String
  errorMessage String  @db.Text
  stackTrace   String? @db.Text

  // Context (JSONB for flexibility)
  contextData Json?

  // Recovery tracking
  recoveryAttempted    Int     @default(0)
  recoverySuccess      Int     @default(0)
  lastRecoveryStrategy String?
  lastRecoveryOutcome  String?

  // Impact assessment
  impactedFeatures    String[]
  estimatedUserImpact Int?

  // Learning metadata (JSONB for ML features)
  learningMetadata Json?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts ErrorAlert[]

  @@index([fingerprint])
  @@index([category])
  @@index([severity])
  @@index([lastSeen(sort: Desc)])
  @@index([occurrenceCount(sort: Desc)])
  @@map("ErrorLog")
}

model ErrorAlert {
  alertId        String    @id @default(uuid())
  errorId        String
  alertType      String
  recipientId    String?
  sentAt         DateTime  @default(now())
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  acknowledgedBy String?

  error ErrorLog @relation(fields: [errorId], references: [errorId], onDelete: Cascade)

  @@index([errorId])
  @@index([sentAt(sort: Desc)])
  @@map("ErrorAlert")
}

// ============================================================================
// Analytics & Logging (TimescaleDB Hypertables)
// ============================================================================

/// Log entries hypertable for Event Bus persistence
/// Enhanced with component, operation, and duration tracking (2025-12-03)
model LogEntry {
  id            BigInt   @id @default(autoincrement())
  timestamp     DateTime @db.Timestamptz
  level         String
  category      String
  message       String?
  metadata      Json?
  correlationId String?  @map("correlation_id") @db.Uuid
  serviceName   String?  @map("service_name")
  userId        String?  @map("user_id")
  traceContext  String?  @map("trace_context")
  
  // New fields for unified ingestion (2025-12-03)
  component     String?  /// High-level component: bot, battle, encounter, database, cache, worker
  operation     String?  /// Specific operation: initialize, start, stop, query, insert, flush
  durationMs    Int?     @map("duration_ms") /// Operation duration in milliseconds

  @@index([level, timestamp(sort: Desc)])
  @@index([category, timestamp(sort: Desc)])
  @@index([correlationId])
  @@index([userId, timestamp(sort: Desc)])
  @@index([serviceName, timestamp(sort: Desc)])
  @@index([component, timestamp(sort: Desc)])
  @@index([operation, timestamp(sort: Desc)])
  @@index([level, component, timestamp(sort: Desc)])
  @@map("log_entries")
}

/// Worker performance metrics hypertable
/// Collected every 15 seconds by metrics-collector.ts
model WorkerMetrics {
  id                    BigInt   @id @default(autoincrement())
  timestamp             DateTime @default(now()) @db.Timestamptz
  
  // Worker identification
  workerId              String   @map("worker_id")
  workerName            String   @map("worker_name")
  
  // Performance metrics
  operationCount        BigInt   @default(0) @map("operation_count")
  successCount          BigInt   @default(0) @map("success_count")
  failureCount          BigInt   @default(0) @map("failure_count")
  avgLatencyMs          Float?   @map("avg_latency_ms")
  peakLatencyMs         Float?   @map("peak_latency_ms")
  throughput            Float?   /// ops/sec
  
  // Buffer metrics (for buffered workers)
  bufferSize            Int?     @map("buffer_size")
  bufferUtilizationPct  Float?   @map("buffer_utilization_pct")
  flushCount            Int?     @map("flush_count")
  backpressureEvents    Int?     @map("backpressure_events")
  
  // Resource metrics
  memoryUsedBytes       BigInt?  @map("memory_used_bytes")
  cpuPercent            Float?   @map("cpu_percent")
  
  // Health status
  healthStatus          String?  @map("health_status") /// healthy, degraded, unhealthy
  lastError             String?  @map("last_error")

  @@index([workerId, timestamp(sort: Desc)])
  @@index([healthStatus, timestamp(sort: Desc)])
  @@map("worker_metrics")
}

/// Console outputs capture for structured logging
/// Captured by console-interceptor.ts
model ConsoleOutput {
  id              BigInt   @id @default(autoincrement())
  timestamp       DateTime @default(now()) @db.Timestamptz
  
  // Output identification
  serviceName     String   @map("service_name") /// 'infinity-gauntlet', 'security-bot', etc.
  outputType      String   @map("output_type") /// 'telemetry', 'stats', 'section', 'banner'
  outputLevel     String   @default("info") @map("output_level") /// 'debug', 'info', 'warn', 'error'
  
  // Content
  rawOutput       String   @map("raw_output") @db.Text
  parsedData      Json?    @map("parsed_data")
  
  // Metadata
  correlationId   String?  @map("correlation_id") @db.Uuid
  sessionId       String?  @map("session_id") /// Render session/deploy ID

  @@index([serviceName, timestamp(sort: Desc)])
  @@index([outputType, timestamp(sort: Desc)])
  @@index([outputLevel, timestamp(sort: Desc)])
  @@map("console_outputs")
}

// ============================================================================
// SECURITY BOT DATABASE MODELS (Sprint 1 - P0-001)
// Security Bot Database Transformation Project
// ============================================================================

/// Severity levels for security events
enum SecuritySeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

/// Threat types for detection system
enum ThreatType {
  RAPID_ROLE_CHANGES
  UNUSUAL_ORIGIN
  MASS_ROLE_REMOVAL
  OFF_HOURS_ACTIVITY
  SINGLE_MEMBER_ANOMALY
  PRIVILEGE_ESCALATION
  UNAUTHORIZED_CHANGE
  BOT_DETECTED_CHANGE
}

/// Admin role request status workflow
enum AdminRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
  CANCELLED
}

/// Core security event tracking — immutable audit trail
/// @description Central security event log with HMAC integrity verification
/// @research R6 (SOC 2 Compliance) - Immutable audit log with hash chain
model SecurityEvent {
  id            BigInt           @id @default(autoincrement())
  
  // Event classification
  eventType     String           /// role-change, threat-detected, permission-violation, sweep, startup, shutdown
  severity      SecuritySeverity @default(INFO)
  
  // Context
  guildId       String           @map("guild_id")
  guildName     String           @map("guild_name")
  memberId      String?          @map("member_id")
  memberTag     String?          @map("member_tag")
  roleId        String?          @map("role_id")
  roleName      String?          @map("role_name")
  executorId    String?          @map("executor_id")
  executorTag   String?          @map("executor_tag")
  origin        String           /// security-bot-sweep, admin-manual, member-join, role-reaction, api-direct
  
  // Payload
  metadata      Json?            /// Additional event-specific data
  
  // Integrity (R6 - Immutable Audit Log)
  signature     String?          /// HMAC-SHA256 signature of event data
  checksum      String           /// Row checksum for tampering detection
  previousHash  String?          @map("previous_hash") /// Hash chain link to previous event
  
  // Timestamps
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([eventType, createdAt(sort: Desc)])
  @@index([guildId, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
  @@index([memberId, createdAt(sort: Desc)])
  @@map("security_events")
}

/// Role change audit trail — detailed tracking of every role modification
/// @description Replaces roleArchive.js JSON storage with database persistence
model RoleChangeAudit {
  id              BigInt   @id @default(autoincrement())
  
  // Guild context
  guildId         String   @map("guild_id")
  guildName       String   @map("guild_name")
  
  // Target member
  memberId        String   @map("member_id")
  memberTag       String   @map("member_tag")
  
  // Change details
  changeType      String   @map("change_type") /// addition, removal
  roleId          String   @map("role_id")
  roleName        String   @map("role_name")
  rolePosition    Int?     @map("role_position") /// Role hierarchy position at time of change
  
  // Executor context
  executorId      String   @map("executor_id")
  executorTag     String   @map("executor_tag")
  executorRoles   String[] @map("executor_roles") /// Executor's roles at time of action
  
  // Authorization
  authorized      Boolean  /// Was this change authorized?
  authReason      String?  @map("auth_reason") /// Why authorized/unauthorized
  
  // Reversion tracking
  reverted        Boolean  @default(false)
  revertedAt      DateTime? @map("reverted_at") @db.Timestamptz
  revertedBy      String?  @map("reverted_by")
  revertReason    String?  @map("revert_reason")
  
  // Source tracking
  origin          String   /// sweep, member-join, admin-manual, security-bot-revert, role-reaction
  
  // Integrity
  checksum        String   /// Row checksum using timing-safe HMAC
  
  // Metadata
  metadata        Json?    /// Additional context
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  threatDetection ThreatDetection[] @relation("TriggeringEntry")

  @@index([guildId, createdAt(sort: Desc)])
  @@index([memberId, createdAt(sort: Desc)])
  @@index([executorId, createdAt(sort: Desc)])
  @@index([authorized, createdAt(sort: Desc)])
  @@index([reverted])
  @@index([changeType, createdAt(sort: Desc)])
  @@map("role_change_audit")
}

/// Threat detection history — forensics and incident response
/// @description Real-time threat detection with MITRE ATT&CK mapping
model ThreatDetection {
  id                BigInt     @id @default(autoincrement())
  
  // Threat classification
  threatType        ThreatType @map("threat_type")
  severity          SecuritySeverity
  confidence        Float      /// 0.0 - 1.0 confidence score
  
  // Context
  guildId           String     @map("guild_id")
  guildName         String     @map("guild_name")
  
  // Details
  description       String     /// Human-readable description
  evidence          Json       /// Detailed evidence for forensics
  triggeringEntryId BigInt?    @map("triggering_entry_id") /// ID of RoleChangeAudit that triggered detection
  
  // MITRE ATT&CK mapping (for enterprise security integration)
  mitreAttack       String?    @map("mitre_attack") /// T1098.003, T1078, T1531, etc.
  mitreTactic       String?    @map("mitre_tactic") /// Persistence, Privilege Escalation, etc.
  
  // Recommended response
  recommendedAction String     @map("recommended_action")
  autoMitigated     Boolean    @default(false) @map("auto_mitigated")
  mitigationAction  String?    @map("mitigation_action") /// What automatic action was taken
  
  // Resolution tracking
  resolved          Boolean    @default(false)
  resolvedBy        String?    @map("resolved_by")
  resolvedAt        DateTime?  @map("resolved_at") @db.Timestamptz
  resolutionNotes   String?    @map("resolution_notes")
  falsePositive     Boolean    @default(false) @map("false_positive")
  
  // Timestamps
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  triggeringEntry   RoleChangeAudit? @relation("TriggeringEntry", fields: [triggeringEntryId], references: [id])

  @@index([threatType, createdAt(sort: Desc)])
  @@index([guildId, createdAt(sort: Desc)])
  @@index([severity, createdAt(sort: Desc)])
  @@index([resolved])
  @@index([falsePositive])
  @@map("threat_detections")
}

/// Security baselines — per-guild behavioral patterns
/// @description Replaces securityBaselines.js with database persistence
model SecurityBaseline {
  id                      BigInt   @id @default(autoincrement())
  
  // Guild identification
  guildId                 String   @unique @map("guild_id")
  guildName               String   @map("guild_name")
  
  // Activity metrics
  averageChangesPerHour   Float    @map("average_changes_per_hour")
  averageChangesPerDay    Float    @map("average_changes_per_day")
  peakActivityHours       Int[]    @map("peak_activity_hours") /// Array of hours (0-23) with high activity
  
  // Thresholds
  rapidChangeThreshold    Int      @map("rapid_change_threshold") /// Changes/minute that triggers alert
  maxChangesPerMember     Int      @map("max_changes_per_member") /// Per-member limit per hour
  
  // Expected patterns
  expectedOrigins         String[] @map("expected_origins") /// Whitelist of normal change origins
  
  // Confidence
  confidenceLevel         Float    @map("confidence_level") /// 0.0 - 1.0 based on data quantity
  dataPointCount          Int      @map("data_point_count") /// Number of entries used for computation
  
  // Timestamps
  computedAt              DateTime @map("computed_at") @db.Timestamptz /// When baseline was last computed
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([guildId])
  @@map("security_baselines")
}

/// Permission snapshots — point-in-time role permission capture
/// @description Cross-reference validation for 4-layer integrity
model PermissionSnapshot {
  id            BigInt   @id @default(autoincrement())
  
  // Role identification
  guildId       String   @map("guild_id")
  guildName     String   @map("guild_name")
  roleId        String   @map("role_id")
  roleName      String   @map("role_name")
  
  // Permission state
  permissions   String[] /// Array of Discord permission flags
  position      Int      /// Role hierarchy position
  color         Int?     /// Role color (for display)
  hoist         Boolean  /// Whether role is displayed separately
  mentionable   Boolean  /// Whether role can be mentioned
  
  // Integrity
  signature     String   /// HMAC signature of permissions array using timing-safe crypto
  
  // Timestamp
  capturedAt    DateTime @default(now()) @map("captured_at") @db.Timestamptz

  @@index([guildId, roleId])
  @@index([capturedAt(sort: Desc)])
  @@unique([guildId, roleId, capturedAt])
  @@map("permission_snapshots")
}

/// Admin role management requests — workflow tracking
/// @description DRIP alert integration for all role changes
model AdminRoleRequest {
  id               BigInt             @id @default(autoincrement())
  
  // Guild context
  guildId          String             @map("guild_id")
  guildName        String             @map("guild_name")
  
  // Requester (Admin making the request)
  requesterId      String             @map("requester_id")
  requesterTag     String             @map("requester_tag")
  requesterRoles   String[]           @map("requester_roles") /// Roles at time of request
  
  // Target member
  targetMemberId   String             @map("target_member_id")
  targetMemberTag  String             @map("target_member_tag")
  
  // Role being modified
  roleId           String             @map("role_id")
  roleName         String             @map("role_name")
  rolePosition     Int                @map("role_position") /// Role hierarchy position
  
  // Request details
  action           String             /// add, remove
  reason           String?            /// Optional reason provided
  
  // Workflow status
  status           AdminRequestStatus @default(PENDING)
  
  // Approval tracking (for Super Admin approval workflow)
  requiresApproval Boolean            @default(false) @map("requires_approval")
  approvedBy       String?            @map("approved_by")
  approvedAt       DateTime?          @map("approved_at") @db.Timestamptz
  rejectedBy       String?            @map("rejected_by")
  rejectedAt       DateTime?          @map("rejected_at") @db.Timestamptz
  rejectionReason  String?            @map("rejection_reason")
  
  // Execution tracking
  executedAt       DateTime?          @map("executed_at") @db.Timestamptz
  executionResult  String?            @map("execution_result") /// success, failed, partial
  executionError   String?            @map("execution_error") /// Error message if failed
  
  // DRIP alert tracking
  dripAlertSent    Boolean            @default(false) @map("drip_alert_sent")
  dripAlertId      String?            @map("drip_alert_id") /// Message ID of sent alert
  dripAlertSentAt  DateTime?          @map("drip_alert_sent_at") @db.Timestamptz
  
  // Metadata
  metadata         Json?              /// Additional context
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@index([guildId, status])
  @@index([requesterId, createdAt(sort: Desc)])
  @@index([targetMemberId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([dripAlertSent])
  @@map("admin_role_requests")
}

/// Integrity verification log — track all validation runs
/// @description Multi-touchpoint integrity validation tracking
model IntegrityCheck {
  id              BigInt   @id @default(autoincrement())
  
  // Check context
  checkType       String   @map("check_type") /// hmac_validation, cross_reference, sweep, baseline_compare
  guildId         String?  @map("guild_id")
  
  // Results
  passed          Boolean
  totalChecked    Int      @map("total_checked")
  failedCount     Int      @map("failed_count")
  failedItems     Json?    @map("failed_items") /// Details of failed validations
  
  // Execution metadata
  durationMs      Int      @map("duration_ms")
  triggeredBy     String   @map("triggered_by") /// scheduler, manual, startup
  correlationId   String?  @map("correlation_id") @db.Uuid
  
  // Timestamps
  startedAt       DateTime @map("started_at") @db.Timestamptz
  completedAt     DateTime @default(now()) @map("completed_at") @db.Timestamptz

  @@index([checkType, completedAt(sort: Desc)])
  @@index([guildId, completedAt(sort: Desc)])
  @@index([passed, completedAt(sort: Desc)])
  @@map("integrity_checks")
}
