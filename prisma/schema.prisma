// Prisma schema for Infinity Gauntlet — MVP entities
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  discordId    String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  coins        Int      @default(0)
  settingsJson Json?
  parties      Party[]
  pokemon      PokemonInstance[]
  encounters   Encounter[]
  battlesP1    Battle[] @relation("BattlesAsP1")
  battlesP2    Battle[] @relation("BattlesAsP2")
  cooldowns    Cooldown[]
  dailyQuestStreak        Int      @default(0)
  dailyQuestLastCompleted DateTime?
  dailyQuestLastReset     DateTime?
}

model PokemonInstance {
  id         String   @id @default(cuid())
  owner      User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId    String
  speciesId  Int
  form       String?  // e.g., "alolan", "galarian"
  level      Int      @default(1)
  exp        Int      @default(0)
  nature     String?
  ivsJson    Json     // {hp, atk, def, spa, spd, spe}
  evsJson    Json     // same shape
  movesJson  Json     // array of {id, pp, maxPP}
  status     String?  // major status (burn, para, etc.)
  hp         Int
  maxHp      Int
  isShiny    Boolean  @default(false)
  nickname   String?
  boxSlot    Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  partySlots PartySlot[]

  @@index([ownerId])
}

model Party {
  id        String       @id @default(cuid())
  owner     User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  slots     PartySlot[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([ownerId])
  @@index([ownerId])
}

model PartySlot {
  id          String          @id @default(cuid())
  party       Party           @relation(fields: [partyId], references: [id], onDelete: Cascade)
  partyId     String
  slot        Int
  pokemon     PokemonInstance @relation(fields: [pokemonId], references: [id], onDelete: Cascade)
  pokemonId   String
  updatedAt   DateTime        @updatedAt

  @@unique([partyId, slot])
  @@unique([pokemonId])
  @@index([partyId])
}

model Encounter {
  id               String   @id @default(cuid())
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId          String
  speciesId        Int
  level            Int
  state            String   // Idle|Spawned|Caught|Fled|Fainted|Expired
  threadChannelId  String?
  startedAt        DateTime @default(now())
  expiresAt        DateTime?
  dataJson         Json?

  @@index([ownerId, state])
  @@index([state, startedAt])
  @@index([threadChannelId])
  @@index([expiresAt])
}

model Battle {
  id            String   @id @default(cuid())
  p1            User     @relation("BattlesAsP1", fields: [p1Id], references: [id])
  p1Id          String
  p2            User     @relation("BattlesAsP2", fields: [p2Id], references: [id])
  p2Id          String
  arenaThreadId String?
  state         String   // Pending|Active|Finished|Aborted
  rngSeed       String
  ruleset       String
  logCompact    Json?
  logFull       Json?
  resultJson    Json?
  startedAt     DateTime @default(now())
  endedAt       DateTime?
  updatedAt     DateTime @updatedAt

  @@index([state, endedAt])
  @@index([p1Id, state, endedAt])
  @@index([p2Id, state, endedAt])
  @@index([arenaThreadId])
}

model Cooldown {
  id        String   @id @default(cuid())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId   String
  kind      String   // e.g., "walk", "battle", etc.
  readyAt   DateTime
  metaJson  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, kind])
  @@index([ownerId, readyAt])
}

enum OutboxStatus {
  pending
  processing
  processed
  error
}

model OutboxMessage {
  id          String        @id @default(cuid())
  topic       String
  payload     Json
  status      OutboxStatus  @default(pending)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  processedAt DateTime?
  error       String?

  @@index([status, processedAt])
  @@index([topic, status])
}
