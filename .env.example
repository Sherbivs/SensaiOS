# Infinity Gauntlet sample environment file (local dev only)
# Copy these values to a secure file (see docs/ai-env-setup.md) and reference it via IG_ENV_FILE.

# ===== Database URLs =====
# 2-NODE CLUSTER ARCHITECTURE (Direct PostgreSQL Only):
# - DEV_DATABASE_URL: DEV master database (source of truth for migrations)
# - PROD_DATABASE_URL: PROD local node (PRIMARY for gameplay with <50ms latency)
# - RENDER_DB_INTERNAL_URL: Direct PostgreSQL Render internal (migrations on Render)
# - RENDER_DB_EXTERNAL_URL: Direct PostgreSQL external access (migrations from laptop)
# - DATABASE_LOCAL_URL: Local workstation PostgreSQL (optional offline mirror)
#
# PRODUCTION PRIORITY (Render):
# PROD_DATABASE_URL is PRIMARY for live gameplay (PROD local node)
# Fallback chain: DEV_DATABASE_URL → RENDER_DB_INTERNAL_URL → RENDER_DB_EXTERNAL_URL
#
# WORKSTATION PRIORITY (Local Development):
# DATABASE_LOCAL_URL becomes PRIMARY when configured
# The local database receives replicated data from DEV/PROD and serves as the low-latency
# workstation cluster for active game sessions.

DEV_DATABASE_URL=postgresql://user:password@host/dev_database_name
PROD_DATABASE_URL=postgresql://user:password@host/prod_database_name
RENDER_DB_INTERNAL_URL=postgresql://user:password@host/database_name
RENDER_DB_EXTERNAL_URL=postgresql://user:password@host.region.render.com:5432/database_name

# LOCAL WORKSTATION (Optional offline mirror)
# This is automatically populated from Store/db/local-url.txt by bootstrap scripts
# or can be set manually for your local PostgreSQL cluster
DATABASE_LOCAL_URL=postgresql://postgres@127.0.0.1:5432/infinity_gauntlet_db

# ===== Tokens =====
# Preferred tokens per bot. The security bot also falls back to BOT_TOKEN if set.
SECURITY_BOT_TOKEN=
POKEMON_BOT_TOKEN=

# Compatibility fallback (used by some tools/scripts)
# BOT_TOKEN=

# Enable the Pokémon bot within the unified worker
# When unset, it auto-enables if POKEMON_BOT_TOKEN is provided
ENABLE_POKEMON_BOT=true

# ===== Slash command registration =====
# Required to run: npm run register:commands
DISCORD_CLIENT_ID=
# Optional: faster iteration by registering in a single guild
# DISCORD_GUILD_ID=

# ===== Role targeting =====
# Use ROLE_ID if you know the exact ID; otherwise ROLE_NAME is used case-insensitively
# ROLE_ID=
# ROLE_NAME=Trainer

# ===== Policy and remediation =====
# ROLE_PERMISSION_POLICY=standard   # or 'snapshot'
# ROLE_PERMISSION_SNAPSHOT_UPDATE=true
# ROLE_PERMISSIONS_AUDIT=true
# ROLE_PERMISSIONS_REMEDIATE=true

# ===== Healing cadence =====
# BACKFILL_CONCURRENCY=8
# BACKFILL_DELAY_MS=20
# BACKFILL_INTERVAL_SECONDS=45
# ROLE_REMEDIATION_INTERVAL_SECONDS=50
# CACHE_TTL_HOURS=24
# OPS_REPORT_INTERVAL_SECONDS=0

# ===== Render / Jobs =====
# POKE_RENDER_SERVICE_ID=
# POKE_REFRESH_CRON=0 * * * *
# POKE_REFRESH_TZ=America/New_York

# ===== Standards enforcement =====
# STANDARD_ENFORCE_ALL=false
# UNLISTED_PERMISSIONS=ViewChannel,SendMessages,ReadMessageHistory,AddReactions,UseExternalEmojis,EmbedLinks,AttachFiles
# STANDARD_EXEMPT_ROLES=
# STANDARD_ALL_PERMS_ROLES=Drip

# ===== Alerting destinations =====
# ALERT_WEBHOOK_URL=
# ALERT_CHANNEL_ID=
# ALERT_USER_ID=DripTVDD            # accepts ID, <@mention>, username#1234, or username

# ===== DM recipients and schedules =====
# RESTART_DM_RECIPIENT=DripTVDD
# SUMMARY_REPORT_RECIPIENT=DripTVDD
# SUMMARY_REPORT_HOUR=3              # 0-23 (local server time)
# SUMMARY_REPORT_MINUTE=0            # 0-59
# DRIP_ALERT_RECIPIENT=DripTVDD
# DRIP_ALERT_HOUR=2                  # 0-23
# DRIP_ALERT_MINUTE=0                # 0-59
# DRIP_ALERT_TIMEZONE=America/New_York

# ===== Diagnostics =====
# CLI_DEBUG_MODE=false
