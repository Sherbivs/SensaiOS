# Copy to .env and set your token (raw token; do not include the "Bot " prefix)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Optional: target role (by name or ID; ID takes precedence)
# ROLE_ID=
# ROLE_NAME=Trainer

# Security healing
# ROLE_PERMISSIONS_REMEDIATE=false
# ROLE_PERMISSION_POLICY=snapshot  # or: standard
# ROLE_PERMISSION_SNAPSHOT_UPDATE=true
# ROLE_REMEDIATION_INTERVAL_MIN=0

# Healing cadence
# STARTUP_BACKFILL=false
# BACKFILL_INTERVAL_MIN=0
# BACKFILL_CONCURRENCY=8
# BACKFILL_DELAY_MS=20
# CACHE_TTL_HOURS=24
# OPS_REPORT_INTERVAL_MIN=0

# Audits / diagnostics
# ROLE_PERMISSIONS_AUDIT=false
# CLI_DEBUG_MODE=false

# Enforce-all mode
# STANDARD_ENFORCE_ALL=false
# UNLISTED_PERMISSIONS=ViewChannel,SendMessages,ReadMessageHistory,AddReactions,UseExternalEmojis,EmbedLinks,AttachFiles
# STANDARD_EXEMPT_ROLES=
# STANDARD_ALL_PERMS_ROLES=

# Alerting (any combination)
# ALERT_WEBHOOK_URL=
# ALERT_CHANNEL_ID=
# ALERT_USER_ID=123456789012345678   # also accepts <@123...>, username#1234, or username
