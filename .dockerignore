# ==========================================
# Docker Ignore - Pokémon Infinity Gauntlet
# ==========================================
# Exclude files not needed in Docker image

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs (rebuilt in container)
dist/
*.tsbuildinfo

# Environment files (use docker-compose.yml environment section)
.env
.env.*
secrets/
!secrets/env.template

# Git
.git/
.gitignore
.github/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output/
tests/
*.test.ts
*.spec.ts
*.test.js
*.spec.js

# Documentation
docs/
*.md
!README.md

# Logs
logs/
*.log

# OS files
.DS_Store
Thumbs.db

# Backups
backups/
*.backup
*.bak

# Local development
Store/
.db-state/

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# CI/CD
.github/
render.yaml

# Temporary files
tmp/
temp/
*.tmp

# Large assets (keep only necessary)
tools/
router/
playbooks/
ops/

# Husky
.husky/
