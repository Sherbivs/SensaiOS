# Dependencies
node_modules/
package-lock.json

# Build output
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# Environment & Secrets
.env
.env.*
!.env.example
secrets/*
!secrets/*.example
!secrets/README.md
!secrets/ROUTER.md
prisma-accelerate.env

# Environment documentation with credentials
docs/environment/*-credentials-*.md
docs/environment/render-credentials-reference.md

# Database files (local PostgreSQL, SQLite)
# Exclude Store contents but keep ROUTER.md meta docs
Store/*
!Store/ROUTER.md
!Store/*/
Store/*/*
!Store/*/ROUTER.md
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Logs & Runtime files
*.log
!ops/standby_refresh.log
logs/
*.pid
*.lock
*.seed
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache directories (runtime only, not source code)
.cache/
data/cache/*
!data/cache/ROUTER.md
**/runtime-cache/
**/discord-cache/
.eslintcache

# Backups
backups/
tmp/backups/
*.backup
*.bak
*.old

# Archives (local historical snapshots only)
ops/ARCHIVE/
docs/ARCHIVE/
**/archive/
ARCHIVE/

# Testing & Coverage
coverage/
.nyc_output/
test-results/
playwright-report/
*.lcov
test-output.txt
ts-prune-output.txt
pbsl-oracle-report.json

# PostgreSQL binaries & debug symbols (tools directory)
# Exclude PostgreSQL binaries but keep ROUTER.md meta docs
tools/pgsql*/pgsql/bin/*
tools/pgsql*/pgsql/lib/
tools/pgsql*/pgsql/share/
tools/pgsql*/pgsql/include/
!tools/pgsql*/pgsql/bin/ROUTER.md
!tools/**/ROUTER.md
!tools/ROUTER.md
!tools/README.md
*.pdb

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Misc
*.tgz
*.gz
*.zip
*.tar

# Temporary/generated files
render-cli.zip
deploy_status.json
service_status.json
pbsl-oracle-report.json
console.sql
db_workflow_check.sql
test-api.js
*-Sensai.gitignore

# Keep data tracked – do NOT ignore /data (except cache subdirectory)
!data/
data/cache/*
