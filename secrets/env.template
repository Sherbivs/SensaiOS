# ==========================================
# INFINITY GAUNTLET - ENVIRONMENT TEMPLATE
# ==========================================
# Copy this to your environment file and fill in actual credentials
# ARCHITECTURE: 2-Node PostgreSQL Cluster (Accelerate REMOVED 2025-11-07)

# ==========================================
# DISCORD BOT CREDENTIALS
# ==========================================
BOT_TOKEN=your_discord_bot_token_here
POKEMON_BOT_TOKEN=your_pokemon_bot_token_here

# ==========================================
# 2-NODE POSTGRESQL CLUSTER
# ==========================================
# Architecture: DEV (master) + PROD (local node) - both direct PostgreSQL

# PROD DATABASE (PRIMARY for live gameplay)
# Direct PostgreSQL on Render local node - <50ms latency
# Format: postgresql://user:password@hostname/database
DATABASE_URL=postgresql://user:password@dpg-prod-node/infinity_gauntlet_db
PROD_DATABASE_URL=postgresql://user:password@dpg-prod-node/infinity_gauntlet_db

# DEV DATABASE (Master - Source of truth for migrations)
# Direct PostgreSQL on Render master node
# Format: postgresql://user:password@hostname/database or hostname.region.render.com/database
DEV_DATABASE_URL=postgresql://user:password@dpg-dev-master/infinity_gauntlet_db
RENDER_DB_INTERNAL_URL=postgresql://user:password@dpg-dev-master/infinity_gauntlet_db
RENDER_DB_EXTERNAL_URL=postgresql://user:password@dpg-dev-master.virginia-postgres.render.com/infinity_gauntlet_db

# ==========================================
# LOCAL WORKSTATION DATABASE (OPTIONAL)
# ==========================================
# PostgreSQL mirror on workstation disk (Store/db/)
# Used for offline development when DEV/PROD unreachable
DATABASE_LOCAL_URL=postgresql://postgres@127.0.0.1:55433/infinity_gauntlet_db

# ==========================================
# USAGE GUIDELINES (2-Node Cluster)
# ==========================================
#
# FOR LIVE GAMEPLAY (Production):
#   Use PROD_DATABASE_URL or DATABASE_URL (PROD local node)
#   Direct PostgreSQL with <50ms latency for battles/encounters
#
# FOR DEVELOPMENT QUERIES:
#   Use DEV_DATABASE_URL or RENDER_DB_INTERNAL_URL (DEV master)
#   Direct access to source of truth database
#
# FOR MIGRATIONS (ALL ENVIRONMENTS):
#   Use DEV_DATABASE_URL or RENDER_DB_EXTERNAL_URL (DEV master)
#   Master database is source of truth for schema changes
#
# FOR OFFLINE DEVELOPMENT (Optional):
#   Use DATABASE_LOCAL_URL (workstation mirror)
#   Fallback when DEV/PROD unreachable
#
# CRITICAL DATABASE URL SELECTION:
#   See docs/database-url-selection.md for canonical logic
#   - Production runtime: PROD_DATABASE_URL (local node)
#   - Development runtime: DEV_DATABASE_URL (master)
#   - Migrations: DEV_DATABASE_URL (master) - NEVER use pooled URLs
#   - All connections are direct PostgreSQL (postgresql://)
#
# OBSOLETE (Removed 2025-11-07):
#   - Prisma Accelerate removed due to DDL limitations and account hold
#   - See docs/ACCELERATE-MIGRATION-ARCHIVE.md for migration details

