# OBSOLETE: Prisma Accelerate removed 2025-11-07
# This template is preserved for historical reference only.
# Use prisma-dev.env.example for current 2-node cluster architecture.
#
# Prisma Accelerate was removed due to:
# - DDL limitation (migrations silently failed)
# - Account hold (P6003: planLimitReached)
# - Higher latency (~200ms vs <50ms with direct PostgreSQL)
#
# See docs/ACCELERATE-MIGRATION-ARCHIVE.md for migration details.

# OBSOLETE - DO NOT USE
OPTIMIZE_API_KEY="replace-with-optimize-api-key"
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=replace-with-accelerate-api-key"
RENDER_DB_INTERNAL_URL="postgresql://user:password@dpg-<cluster-id>/infinity_gauntlet_db?sslmode=require"
RENDER_DB_EXTERNAL_URL="postgresql://user:password@ppg-<cluster-id>.region.render.com:5432/infinity_gauntlet_db?sslmode=require"

