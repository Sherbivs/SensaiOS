# Prisma Accelerate secret template (local dev only)
# Copy to a secure location as prisma-accelerate.env and populate with real values.
OPTIMIZE_API_KEY="replace-with-optimize-api-key"
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=replace-with-accelerate-api-key"
DATABASE_DIRECT_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=replace-with-direct-api-key"
