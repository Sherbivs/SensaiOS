# Prisma Accelerate secret template (local dev only)
# Copy to a secure location as prisma-accelerate.env and populate with real values.
OPTIMIZE_API_KEY="replace-with-optimize-api-key"
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=replace-with-accelerate-api-key"
# Prisma requires migrations to run over a direct PostgreSQL connection string (no prisma+ prefix).
RENDER_DB_INTERNAL_URL="postgresql://user:password@dpg-<cluster-id>/infinity_gauntlet_db?sslmode=require"
RENDER_DB_EXTERNAL_URL="postgresql://user:password@ppg-<cluster-id>.region.render.com:5432/infinity_gauntlet_db?sslmode=require"
