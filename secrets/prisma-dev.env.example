# Local Prisma development secrets template
# Copy to C:/Users/sherb/OneDrive/Documents/Key/Dev/.env with real credentials.
#
# PRODUCTION STANDARD (2-Node Cluster):
# - DATABASE_URL: PROD database (direct PostgreSQL, local Render node)
# - RENDER_DB_INTERNAL_URL: DEV database (direct PostgreSQL, Render master node for migrations)
# - RENDER_DB_EXTERNAL_URL: DEV database (direct PostgreSQL, external access from laptop)
# - DATABASE_LOCAL_URL: Local workstation PostgreSQL (PRIMARY for live gameplay)
#
# WORKSTATION GAMEPLAY PRIORITY:
# When working locally, DATABASE_LOCAL_URL is the PRIMARY database for active game sessions.
# It provides <50ms latency for battles, encounters, and trainer operations.
# Data is synced FROM PROD/DEV TO LOCAL via the replication system.
#
# ARCHITECTURE: 2-Node Cluster (Accelerate REMOVED 2025-11-07)
# All connections use direct PostgreSQL URLs (postgresql://) for <50ms latency.

# Production format (2-node cluster - all direct PostgreSQL):
DATABASE_URL="postgresql://infinity_gauntlet_db_user:password@dpg-xxxxxxx/infinity_gauntlet_db"
RENDER_DB_INTERNAL_URL="postgresql://infinity_gauntlet_db_user:password@dpg-xxxxxxx/infinity_gauntlet_db"
RENDER_DB_EXTERNAL_URL="postgresql://infinity_gauntlet_db_user:password@dpg-xxxxxxx.virginia-postgres.render.com/infinity_gauntlet_db"

# LOCAL WORKSTATION (PRIMARY for live gameplay):
# Auto-populated from Store/db/local-url.txt or set manually
DATABASE_LOCAL_URL="postgresql://postgres@127.0.0.1:55433/infinity_gauntlet_db"

# Alternative: Local PostgreSQL for all connections (simple development):
# DATABASE_URL="postgresql://user:password@localhost:5432/infinity_gauntlet"
# RENDER_DB_INTERNAL_URL="postgresql://user:password@localhost:5432/infinity_gauntlet"
# RENDER_DB_EXTERNAL_URL="postgresql://user:password@localhost:5432/infinity_gauntlet"
# DATABASE_LOCAL_URL="postgresql://user:password@localhost:5432/infinity_gauntlet"

# Prisma Optimize (optional performance monitoring):
OPTIMIZE_API_KEY="your_prisma_optimize_api_key"



