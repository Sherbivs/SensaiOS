# Local Prisma development secrets template
# Copy to C:/Users/sherb/OneDrive/Documents/Key/Dev/.env with real credentials.
#
# PRODUCTION STANDARD (Render):
# - DATABASE_URL: Prisma Accelerate pool connection (primary for Render)
# - DATABASE_POOL_URL: Same as DATABASE_URL (alias for compatibility)
# - DATABASE_DIRECT_URL: Direct PostgreSQL connection (migrations/dev)
# - DATABASE_LOCAL_URL: Local workstation PostgreSQL (PRIMARY for live gameplay)
#
# WORKSTATION GAMEPLAY PRIORITY:
# When working locally, DATABASE_LOCAL_URL is the PRIMARY database for active game sessions.
# It provides <50ms latency for battles, encounters, and trainer operations.
# Data is synced FROM PROD/DEV TO LOCAL via the replication system.
#
# LOCAL DEVELOPMENT:
# For local dev, you can use direct PostgreSQL URLs for all three variables,
# or use the production Prisma Accelerate URLs to match production behavior.

# Production format (recommended - matches Render):
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_ACCELERATE_API_KEY"
DATABASE_POOL_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_PRISMA_ACCELERATE_API_KEY"
DATABASE_DIRECT_URL="postgresql://infinity_gauntlet_db_user:password@dpg-xxxxxxx.virginia-postgres.render.com/infinity_gauntlet_db"

# LOCAL WORKSTATION (PRIMARY for live gameplay):
# Auto-populated from Store/db/local-url.txt or set manually
DATABASE_LOCAL_URL="postgresql://postgres@127.0.0.1:55433/infinity_gauntlet_db"

# Alternative: Local PostgreSQL for all connections (simple development):
# DATABASE_URL="postgresql://user:password@localhost:5432/infinity_gauntlet"
# DATABASE_POOL_URL="postgresql://user:password@localhost:5432/infinity_gauntlet"
# DATABASE_DIRECT_URL="postgresql://user:password@localhost:5432/infinity_gauntlet"
# DATABASE_LOCAL_URL="postgresql://user:password@localhost:5432/infinity_gauntlet"

# Prisma Optimize (optional performance monitoring):
OPTIMIZE_API_KEY="your_prisma_optimize_api_key"


