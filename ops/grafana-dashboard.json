{
  "dashboard": {
    "title": "Security Intelligence System",
    "tags": ["security", "intelligence", "discord"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Security Score",
        "type": "gauge",
        "targets": [
          {
            "expr": "security_score",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "auto",
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0,
            "max": 100,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 50,
                  "color": "yellow"
                },
                {
                  "value": 80,
                  "color": "green"
                }
              ]
            }
          }
        },
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 6,
          "h": 8
        }
      },
      {
        "id": 2,
        "title": "Threats Detected (24h)",
        "type": "timeseries",
        "targets": [
          {
            "expr": "increase(security_threats_detected_total[24h])",
            "legendFormat": "{{severity}}",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "CRITICAL"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "HIGH"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "orange"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "MEDIUM"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "yellow"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "LOW"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "blue"
                  }
                }
              ]
            }
          ]
        },
        "gridPos": {
          "x": 6,
          "y": 0,
          "w": 18,
          "h": 8
        }
      },
      {
        "id": 3,
        "title": "Threat Severity Breakdown",
        "type": "piechart",
        "targets": [
          {
            "expr": "sum by (severity) (security_threats_detected_total)",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "right"
          },
          "pieType": "pie"
        },
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "CRITICAL"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "HIGH"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "orange"
                  }
                }
              ]
            }
          ]
        },
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 8,
          "h": 8
        }
      },
      {
        "id": 4,
        "title": "Response Actions",
        "type": "stat",
        "targets": [
          {
            "expr": "sum by (action) (security_response_actions_total)",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "textMode": "value_and_name",
          "colorMode": "background"
        },
        "gridPos": {
          "x": 8,
          "y": 8,
          "w": 8,
          "h": 8
        }
      },
      {
        "id": 5,
        "title": "Integrity Status",
        "type": "stat",
        "targets": [
          {
            "expr": "security_integrity_checks_total - security_integrity_checks_failed_total",
            "legendFormat": "Passed",
            "refId": "A"
          },
          {
            "expr": "security_integrity_checks_failed_total",
            "legendFormat": "Failed",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Passed"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "green"
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Failed"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "fixed",
                    "fixedColor": "red"
                  }
                }
              ]
            }
          ]
        },
        "gridPos": {
          "x": 16,
          "y": 8,
          "w": 8,
          "h": 8
        }
      },
      {
        "id": 6,
        "title": "Performance Metrics",
        "type": "timeseries",
        "targets": [
          {
            "expr": "performance_function_duration_ms{function=\"baseline_generation\"}",
            "legendFormat": "Baseline Generation",
            "refId": "A"
          },
          {
            "expr": "performance_function_duration_ms{function=\"threat_detection\"}",
            "legendFormat": "Threat Detection",
            "refId": "B"
          },
          {
            "expr": "performance_function_duration_ms{function=\"metrics_calculation\"}",
            "legendFormat": "Metrics Calculation",
            "refId": "C"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth"
            }
          }
        },
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 7,
        "title": "Memory Usage",
        "type": "timeseries",
        "targets": [
          {
            "expr": "system_health_memory_heap_used_bytes / 1024 / 1024",
            "legendFormat": "Heap Used (MB)",
            "refId": "A"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "unit": "MB",
            "custom": {
              "drawStyle": "line",
              "lineInterpolation": "smooth",
              "fillOpacity": 10
            },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 40,
                  "color": "yellow"
                },
                {
                  "value": 50,
                  "color": "red"
                }
              ]
            }
          }
        },
        "gridPos": {
          "x": 12,
          "y": 16,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 8,
        "title": "System Health",
        "type": "table",
        "targets": [
          {
            "expr": "system_health_uptime_seconds / 3600",
            "legendFormat": "Uptime (hours)",
            "refId": "A",
            "instant": true
          },
          {
            "expr": "system_health_errors_total",
            "legendFormat": "Total Errors",
            "refId": "B",
            "instant": true
          },
          {
            "expr": "(time() - security_sweep_last_completed_timestamp) / 60",
            "legendFormat": "Last Sweep (minutes ago)",
            "refId": "C",
            "instant": true
          },
          {
            "expr": "security_baseline_confidence",
            "legendFormat": "Baseline Confidence",
            "refId": "D",
            "instant": true
          }
        ],
        "options": {
          "showHeader": true
        },
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Baseline Confidence"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percentunit"
                }
              ]
            }
          ]
        },
        "gridPos": {
          "x": 0,
          "y": 24,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 9,
        "title": "Member Anomaly Scores (Top 10)",
        "type": "bargauge",
        "targets": [
          {
            "expr": "topk(10, security_member_anomaly_score)",
            "legendFormat": "{{member_id}}",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "green"
                },
                {
                  "value": 0.5,
                  "color": "yellow"
                },
                {
                  "value": 0.8,
                  "color": "red"
                }
              ]
            }
          }
        },
        "gridPos": {
          "x": 12,
          "y": 24,
          "w": 12,
          "h": 8
        }
      },
      {
        "id": 10,
        "title": "Cache Hit Rate",
        "type": "gauge",
        "targets": [
          {
            "expr": "performance_cache_hit_rate",
            "refId": "A"
          }
        ],
        "options": {
          "orientation": "auto",
          "showThresholdLabels": false,
          "showThresholdMarkers": true
        },
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "value": 0,
                  "color": "red"
                },
                {
                  "value": 0.5,
                  "color": "yellow"
                },
                {
                  "value": 0.8,
                  "color": "green"
                }
              ]
            }
          }
        },
        "gridPos": {
          "x": 0,
          "y": 32,
          "w": 6,
          "h": 8
        }
      },
      {
        "id": 11,
        "title": "Time-Series Trends",
        "type": "timeseries",
        "targets": [
          {
            "expr": "security_time_series_hourly_changes_total",
            "legendFormat": "Hourly Changes",
            "refId": "A"
          },
          {
            "expr": "security_time_series_daily_changes_total",
            "legendFormat": "Daily Changes",
            "refId": "B"
          }
        ],
        "options": {
          "legend": {
            "displayMode": "list",
            "placement": "bottom"
          }
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "drawStyle": "bars",
              "fillOpacity": 50
            }
          }
        },
        "gridPos": {
          "x": 6,
          "y": 32,
          "w": 18,
          "h": 8
        }
      },
      {
        "id": 12,
        "title": "Alert Summary",
        "type": "alertlist",
        "options": {
          "showOptions": "current",
          "maxItems": 20,
          "sortOrder": 1,
          "dashboardAlerts": false,
          "alertName": "",
          "dashboardTitle": "",
          "tags": [],
          "stateFilter": {
            "firing": true,
            "pending": true,
            "ok": false
          }
        },
        "gridPos": {
          "x": 0,
          "y": 40,
          "w": 24,
          "h": 8
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        },
        {
          "datasource": "Prometheus",
          "enable": true,
          "expr": "ALERTS{alertstate=\"firing\",severity=\"critical\"}",
          "iconColor": "red",
          "name": "Critical Alerts",
          "step": "60s",
          "tagKeys": "alertname",
          "textFormat": "{{alertname}}: {{summary}}",
          "titleFormat": "Critical Alert"
        }
      ]
    },
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus",
          "current": {
            "text": "Prometheus",
            "value": "Prometheus"
          }
        },
        {
          "name": "interval",
          "type": "interval",
          "query": "1m,5m,10m,30m,1h,6h,12h,1d",
          "current": {
            "text": "5m",
            "value": "5m"
          }
        }
      ]
    }
  }
}
