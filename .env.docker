# ==========================================
# DOCKER ENVIRONMENT TEMPLATE
# ==========================================
# Copy this to .env and fill in actual credentials
# Used by docker-compose.yml for local development

# ==========================================
# DISCORD BOT CREDENTIALS (REQUIRED)
# ==========================================
BOT_TOKEN=your_discord_bot_token_here
POKEMON_BOT_TOKEN=your_pokemon_bot_token_here

# ==========================================
# SECURITY BOT (OPTIONAL)
# ==========================================
# Only needed if running security profile
SECURITY_BOT_TOKEN=your_security_bot_token_here
ALERT_WEBHOOK_URL=
ALERT_CHANNEL_ID=
ALERT_USER_ID=

# ==========================================
# DATABASE PASSWORD
# ==========================================
# PostgreSQL password for local container
POSTGRES_PASSWORD=localdev123

# ==========================================
# GITHUB TOKENS (OPTIONAL)
# ==========================================
# Only needed for data pipeline worker
GITHUB_TOKEN=
RENDER_API_KEY=

# ==========================================
# USAGE INSTRUCTIONS
# ==========================================
# 1. Copy this file to .env: cp .env.docker .env
# 2. Fill in your Discord bot tokens
# 3. Run: docker-compose up -d
# 4. Check logs: docker-compose logs -f bot
# 5. Stop: docker-compose down
#
# To enable security bot:
#   docker-compose --profile security up -d
#
# To rebuild after code changes:
#   docker-compose up -d --build
#
# To run migrations:
#   docker-compose exec bot npx prisma migrate deploy
