{
  "name": "infinity-gauntlet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ci": "npm run prebuild",
    "postinstall": "npm run prebuild",
  "generate": "prisma generate --no-engine",
    "prebuild": "npm run generate && npm run build:ts",
    "build:ts": "tsc --project tsconfig.build.json",
    "build": "npm run build:ts",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "data:build": "tsx src/data_pipeline/index.ts",
    "register:commands": "node scripts/register-commands.js",
    "docs:update-ledger": "node scripts/update_change_ledger.mjs",
    "docs:update-routers": "bash scripts/update_router_index.sh",
    "refresh:vision": "bash scripts/refresh_vision.sh",
    "hotfix": "bash scripts/hotfix_entry.sh",
    "tasks:archive": "node scripts/archive_task_history.mjs",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "test": "vitest",
    "test:pbsl": "vitest run tests/pbsl",
    "worker:outbox": "tsx src/worker/outbox.ts",
    "worker:cache": "tsx src/worker/cache-refresh.ts",
    "worker:data-pipeline": "tsx src/worker/data-pipeline.ts",
    "worker:security": "node security-bot.js"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^17.9.0",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "^3.3.1",
    "prisma": "^6.18.0",
    "vitest": "^4.0.4"
  },
  "dependencies": {
    "@prisma/client": "^6.18.0",
    "@prisma/extension-accelerate": "^2.0.2",
    "discord.js": "^14.16.3",
    "tsx": "^4.11.2",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  }
}
