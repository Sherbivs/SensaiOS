{
  "name": "infinity-gauntlet",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "---DOMAIN-CLIS---": "================= UNIFIED DOMAIN CLIs (Scripts Overhaul 2025-12) =================",
    "render": "tsx scripts/render/cli.ts",
    "observe": "tsx scripts/observe/logs.ts",
    "logq": "tsx scripts/logq.ts",
    "sensaios": "tsx scripts/sensaios-cli.ts",
    "migrate:scan": "tsx scripts/migrate-console.ts",
    "db": "tsx scripts/db/cli.ts",
    "diagnose": "tsx scripts/diagnose/cli.ts",
    "docker": "tsx scripts/docker/cli.ts",
    "data": "tsx scripts/data/cli.ts",
    "ops": "tsx scripts/ops/cli.ts",
    "---BUILD---": "================= BUILD & DEVELOPMENT =================",
    "build:ci": "npm run prebuild",
    "validate:urls": "tsx scripts/validate-database-urls.ts",
    "generate:types": "tsx scripts/generate-pg-types.ts",
    "prebuild": "echo 'Starting prebuild...' && npm run validate:urls && npx prisma generate && echo 'Running TypeScript build...' && npm run build:ts && echo 'Build complete!' && npm run verify:dist",
    "build:ts": "bash scripts/build-typescript.sh",
    "build": "npm run build:ts",
    "verify:dist": "node -e \"const fs=require('fs'); const path=require('path'); function findProjectRoot(){const checks=['.','..','..']; for(const dir of checks){const testPath=path.join(dir,'package.json'); if(fs.existsSync(testPath)){return path.resolve(dir)}} if(fs.existsSync('/opt/render/project/package.json')){return '/opt/render/project'} return null} const root=findProjectRoot(); if(!root){console.log('[HALT] Project root not found'); process.exit(1)} const distPath=path.join(root,'dist','index.js'); if(fs.existsSync(distPath)){console.log('[OK] dist/index.js at:',distPath)}else{console.log('[HALT] dist/index.js not found at:',distPath); process.exit(1)}\"",
    "dev": "tsx watch src/index.ts",
    "dev:secure": "tsx --import ./dist/sensaios/loader/module-hook.js watch src/index.ts",
    "start": "node dist/index.js",
    "start:secure": "node --import ./dist/sensaios/loader/module-hook.js dist/index.js",
    "start:dev": "tsx src/index.ts",
    "---DATA---": "================= DATA PIPELINE =================",
    "data:build": "tsx src/data_pipeline/index.ts",
    "data:dexpack": "npm run data:dexpack:v1 && npm run data:dexpack:v2",
    "data:dexpack:v1": "tsx scripts/build-dexpack.ts",
    "data:dexpack:v2": "tsx scripts/build-dexpack.ts",
    "---DOCS---": "================= DOCUMENTATION =================",
    "docs:update-ledger": "node scripts/update-change-ledger.mjs",
    "docs:update-routers": "bash scripts/update-router-index.sh",
    "refresh:vision": "bash scripts/refresh-vision.sh",
    "tasks:archive": "node scripts/archive-task-history.mjs",
    "---DATABASE---": "================= DATABASE OPERATIONS =================",
    "db:cli": "tsx scripts/db-admin.ts",
    "db:replication": "tsx scripts/db_replication.ts",
    "db:seed:dex": "tsx scripts/seed-dex.ts",
    "db:auto-sync": "tsx scripts/dev-prod-auto-sync.ts",
    "---OPS-BOOTSTRAP---": "================= ON-PREMISE DATABASE BOOTSTRAP =================",
    "ops:bootstrap-onpremise-dev": "tsx scripts/ops/bootstrap-onpremise-dev.ts",
    "ops:auto-bootstrap-onpremise-dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops/auto-bootstrap-onpremise-dev.ps1",
    "ops:bootstrap-onpremise-experiment": "tsx scripts/ops/bootstrap-onpremise-experiment.ts",
    "ops:sync-onpremise-experiment": "tsx scripts/ops/sync-onpremise-experiment.ts",
    "ops:start-onpremise-experiment": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops/start-onpremise-experiment.ps1",
    "ops:stop-onpremise-experiment": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops/stop-onpremise-experiment.ps1",
    "ops:status-onpremise-dbs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops/status-onpremise-dbs.ps1",
    "---DISCORD---": "================= DISCORD BOT =================",
    "register:commands": "tsx scripts/register-commands.ts",
    "hotfix": "bash scripts/hotfix-entry.sh",
    "---GUARDS---": "================= CI GUARDS =================",
    "guard": "npx tsx scripts/guard/cli.ts",
    "guard:all": "npx tsx scripts/guard/cli.ts all",
    "guard:meta": "npx tsx scripts/guard/cli.ts meta",
    "guard:routing": "npx tsx scripts/guard/cli.ts routing",
    "guard:secrets": "npx tsx scripts/guard/cli.ts secrets",
    "guard:auto-sync": "npx tsx scripts/guard/cli.ts auto-sync",
    "guard:dexpack": "npx tsx scripts/guard/cli.ts dexpack",
    "guard:db-preload": "npx tsx scripts/guard/cli.ts db-preload",
    "measure:startup": "node scripts/measure-startup-time.mjs",
    "measure:memory": "node --expose-gc scripts/measure-memory.mjs",
    "monitor:memory": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/monitor-memory-enhanced.ps1",
    "monitor:memory:24h": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/monitor-memory-24h.ps1",
    "verify:metrics": "node scripts/verify-metrics-accuracy.mjs --all",
    "verify:metrics:staged": "node scripts/verify-metrics-accuracy.mjs --staged",
    "setup:git-hooks": "node scripts/setup-git-hooks.mjs",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "validate:boundaries": "tsx scripts/validate-boundaries.ts",
    "check:dead-code": "tsx scripts/check-dead-code.ts",
    "deps:graph": "tsx scripts/generate-dependency-graph.ts",
    "deps:circular": "tsx scripts/generate-dependency-graph.ts --circular",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "guard:store": "bash scripts/verify-store-protection.sh",
    "guard:pre-commit": "bash scripts/pre-commit-store-guard.sh",
    "precommit": "npm run guard:store",
    "test:watch": "vitest",
    "test:pbsl": "vitest run tests/pbsl",
    "test:error-integration": "tsx scripts/test-error-integration.ts",
    "test:sim": "node tests/simulation/test-runner.ts",
    "test:sim:parallel": "node tests/simulation/test-runner.ts --parallel",
    "test:sim:core": "node tests/simulation/test-runner.ts --category=core",
    "test:sim:integration": "node tests/simulation/test-runner.ts --category=integration",
    "test:sim:stress": "node tests/simulation/test-runner.ts --category=stress",
    "test:sim:verbose": "node tests/simulation/test-runner.ts --verbose",
    "test:sim:bail": "node tests/simulation/test-runner.ts --bail",
    "test:all": "npm test && npm run test:sim",
    "chat:ui": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/simulation/open-chat-ui.ps1",
    "bench:dex": "vitest bench tests/dexpack.microbench.ts",
    "---WORKERS---": "================= WORKER PROCESSES =================",
    "worker:outbox": "tsx src/worker/outbox.ts",
    "worker:cache": "tsx src/worker/cache-refresh.ts",
    "worker:data-pipeline": "tsx src/worker/data-pipeline.ts",
    "worker:security": "tsx security-bot.ts",
    "---RENDER-SSH---": "================= RENDER SSH (use 'npm run render' CLI for more options) =================",
    "render:ssh": "tsx scripts/render/cli.ts ssh --interactive",
    "render:ssh-disk": "tsx scripts/render/cli.ts disk",
    "render:ssh-disk-detailed": "tsx scripts/render/cli.ts disk --detailed",
    "render:ssh-cleanup": "tsx scripts/render/cli.ts cleanup --dry-run",
    "---AI-LOGS---": "================= AI LOG ANALYSIS =================",
    "ai-logs:query": "node src/cli/ai-log-query.js query",
    "ai-logs:analyze": "node src/cli/ai-log-query.js analyze",
    "ai-logs:patterns": "node src/cli/ai-log-query.js patterns",
    "ai-logs:insights": "node src/cli/ai-log-query.js insights",
    "ai-logs:stats": "node src/cli/ai-log-query.js stats",
    "prepare": "node -e \"if(process.env.CI||process.env.RENDER)process.exit(0);require('child_process').execSync('husky',{stdio:'inherit'})\""
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^4.28.10",
    "@types/node": "^25.0.3",
    "@types/pg": "^8.16.0",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^17.9.0",
    "eslint-plugin-promise": "^7.2.1",
    "glob": "^13.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.3.0",
    "axios": "^1.13.1",
    "chalk": "^5.3.0",
    "commander": "^14.0.2",
    "discord.js": "^14.16.3",
    "dotenv": "^17.2.3",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "octokit": "^5.0.5",
    "pg": "^8.16.3",
    "prisma": "^7.3.0",
    "prom-client": "^15.1.3",
    "sql.js": "^1.12.0",
    "tsx": "^4.11.2",
    "typescript": "^5.6.3",
    "zod": "^4.1.12"
  },
  "lint-staged": {
    "src/**/*.{js,ts}": [
      "eslint"
    ],
    "tests/**/*.{js,ts}": [
      "eslint"
    ]
  },
  "overrides": {
    "effect": "3.19.12",
    "fast-check": "3.22.0",
    "hono": "4.11.9",
    "undici": "6.23.0",
    "lodash": "4.17.23"
  }
}
