{
  "name": "infinity-gauntlet",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ci": "npm run prebuild",
    "postinstall": "npx prisma generate && echo 'Running postinstall TypeScript build...' && npm run build:ts && echo 'postinstall build complete'",
    "validate:urls": "node scripts/validate_database_urls.js",
    "generate:types": "tsx scripts/generate_pg_types.ts",
    "prebuild": "echo 'Starting prebuild...' && npm run validate:urls && npx prisma generate && echo 'Running TypeScript build...' && npm run build:ts && echo 'Build complete!' && npm run verify:dist",
    "build:ts": "bash scripts/build_typescript.sh",
    "build": "npm run build:ts",
    "verify:dist": "node -e \"const fs=require('fs'); const path=require('path'); function findProjectRoot(){const checks=['.','..','..']; for(const dir of checks){const testPath=path.join(dir,'package.json'); if(fs.existsSync(testPath)){return path.resolve(dir)}} if(fs.existsSync('/opt/render/project/package.json')){return '/opt/render/project'} return null} const root=findProjectRoot(); if(!root){console.error('✗ Cannot find project root'); process.exit(1)} const distPath=path.join(root,'dist','index.js'); if(fs.existsSync(distPath)){console.log('✓ Found dist/index.js at:',distPath)}else{console.error('✗ FATAL: dist/index.js not found'); console.log('Project root:',root); console.log('Expected:',distPath); process.exit(1)}\"",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "data:build": "tsx src/data_pipeline/index.ts",
    "data:dexpack": "npm run data:dexpack:v1 && npm run data:dexpack:v2",
    "data:dexpack:v1": "tsx scripts/build_dexpack.ts",
    "data:dexpack:v2": "tsx scripts/build-dexpack.ts",
    "register:commands": "node scripts/register-commands.js",
    "docs:update-ledger": "node scripts/update_change_ledger.mjs",
    "docs:update-routers": "bash scripts/update_router_index.sh",
    "refresh:vision": "bash scripts/refresh_vision.sh",
    "hotfix": "bash scripts/hotfix_entry.sh",
    "tasks:archive": "node scripts/archive_task_history.mjs",
    "db:cli": "tsx scripts/db_admin.ts",
    "db:replication": "tsx scripts/db_replication.ts",
    "db:seed:dex": "tsx scripts/seed_dex.ts",
    "db:auto-sync": "tsx scripts/dev_prod_auto_sync.ts",
    "db:smoke": "tsx scripts/db_smoke.ts",
    "guard:auto-sync": "bash scripts/guards/guard_auto_sync.sh",
    "ops:dex-v2-backup": "tsx scripts/ops/dex_v2_backup.ts",
    "ops:simulate-flag": "tsx scripts/ops/simulate_flag_rollout.ts",
    "ops:dex-v2-alert-dry-run": "tsx scripts/ops/dex_v2_alert_dry_run.ts",
    "ops:bootstrap-onpremise-dev": "tsx scripts/ops/bootstrap_onpremise_dev.ts",
    "ops:auto-bootstrap-onpremise-dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops/auto_bootstrap_onpremise_dev.ps1",
    "ops:bootstrap-onpremise-experiment": "tsx scripts/ops/bootstrap_onpremise_experiment.ts",
    "ops:sync-onpremise-experiment": "tsx scripts/ops/sync_onpremise_experiment.ts",
    "ops:start-onpremise-experiment": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops/start_onpremise_experiment.ps1",
    "ops:stop-onpremise-experiment": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops/stop_onpremise_experiment.ps1",
    "ops:status-onpremise-dbs": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ops/status_onpremise_dbs.ps1",
    "guard:dexpack": "bash scripts/guards/guard_dexpack.sh",
    "db:mirror:check": "tsx scripts/db_mirror_checks.ts",
    "measure:startup": "node scripts/measure_startup_time.mjs",
    "measure:memory": "node --expose-gc scripts/measure_memory.mjs",
    "migrate:console-logs": "node scripts/migrate_console_logs.mjs",
    "migrate:console-logs:dry-run": "node scripts/migrate_console_logs.mjs --dry-run",
    "lint": "eslint \"{src,tests}/**/*.ts\"",
    "test": "vitest --run",
    "guard:store": "bash scripts/verify_store_protection.sh",
    "guard:pre-commit": "bash scripts/pre-commit-store-guard.sh",
    "precommit": "npm run guard:store",
    "test:watch": "vitest",
    "test:pbsl": "vitest run tests/pbsl",
    "test:error-integration": "tsx scripts/test-error-integration.ts",
    "bench:dex": "vitest bench tests/dexpack.microbench.ts",
    "worker:outbox": "tsx src/worker/outbox.ts",
    "worker:cache": "tsx src/worker/cache-refresh.ts",
    "worker:data-pipeline": "tsx src/worker/data-pipeline.ts",
    "worker:security": "node security-bot.js",
    "render:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_status.ps1",
    "render:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_deploy.ps1 -Service Infinity-Gauntlet",
    "render:deploys": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_deploys.ps1 -Service Infinity-Gauntlet",
    "render:restart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_restart.ps1 -Service Infinity-Gauntlet",
    "render:job": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_run_job.ps1",
    "render:check-db": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_run_job.ps1 -ServiceId srv-d3snk2ndiees73cn709g -Command 'npx tsx scripts/check_prisma_findmany.ts'",
    "render:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_run_job.ps1 -ServiceId srv-d3snk2ndiees73cn709g -Command 'npx prisma migrate deploy'",
    "render:ssh-setup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_ssh_setup.ps1",
    "render:ssh-connect": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_ssh_connect.ps1",
    "render:ssh-exec": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_ssh_exec.ps1",
    "render:ssh-transfer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_ssh_transfer.ps1",
    "render:ssh-tunnel": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render_ssh_tunnel.ps1",
    "ai-logs:query": "node src/cli/ai-log-query.js query",
    "ai-logs:analyze": "node src/cli/ai-log-query.js analyze",
    "ai-logs:patterns": "node src/cli/ai-log-query.js patterns",
    "ai-logs:insights": "node src/cli/ai-log-query.js insights",
    "ai-logs:stats": "node src/cli/ai-log-query.js stats"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.9.2",
    "@types/pg": "^8.11.6",
    "@types/sql.js": "^1.4.9",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^17.9.0",
    "eslint-plugin-promise": "^7.2.1",
    "glob": "^11.0.3",
    "globals": "^16.5.0",
    "patch-package": "^8.0.0",
    "prisma": "^6.19.0",
    "vitest": "^4.0.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.619.0",
    "@prisma/client": "^6.19.0",
    "axios": "^1.13.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "discord.js": "^14.16.3",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fs-extra": "^11.3.2",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "octokit": "^5.0.5",
    "pg": "^8.16.3",
    "simple-git": "^3.29.0",
    "sql.js": "^1.12.0",
    "tsx": "^4.11.2",
    "typescript": "^5.6.3",
    "zod": "^4.1.12"
  }
}
