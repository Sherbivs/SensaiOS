{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Render SSH (Windows): Interactive",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/scripts/render_ssh_windows.ps1",
        "-Interactive"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": false
    },
    {
      "label": "Render SSH (Windows): Check Disk Usage",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/scripts/render_disk_usage_windows.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Render SSH (Windows): Detailed Disk Usage",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/scripts/render_disk_usage_windows.ps1",
        "-Detailed"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Render SSH (Windows): Cleanup Heaps (Dry Run)",
      "type": "shell",
      "command": "pwsh",
      "args": [
        "-File",
        "${workspaceFolder}/scripts/render_cleanup_heaps_windows.ps1",
