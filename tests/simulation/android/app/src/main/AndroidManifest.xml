<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- PERMISSIONS                                                         -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    
    <!-- Network Permissions (No runtime permission required) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    
    <!-- Foreground Service Permission (Android 9.0+ / API 28+) -->
    <!-- Required for TestRunnerService to run in foreground -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" android:minSdkVersion="34" />
    
    <!-- Notification Permission (Android 13+ / API 33+) -->
    <!-- Runtime permission required on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    
    <!-- Wake Lock Permission (Optional, for keeping device awake during tests) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    
    <!-- Vibration Permission (Optional, for notification alerts) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".InfinityGauntletApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.InfinityGauntletSimulation" android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.InfinityGauntletSimulation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Chat UI Activity -->
        <activity
            android:name=".ChatUIActivity"
            android:exported="false"
            android:label="@string/chat_ui_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.InfinityGauntletSimulation" />

        <!-- Report Viewer Activity -->
        <activity
            android:name=".ReportViewerActivity"
            android:exported="false"
            android:label="@string/report_viewer_title"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.InfinityGauntletSimulation" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SERVICES                                                        -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        
        <!-- Test Runner Service (Foreground Service) -->
        <service
            android:name=".services.TestRunnerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:targetApi="34" />
        
        <!-- Report Generator Service (Foreground Service) -->
        <service
            android:name=".services.ReportGeneratorService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync"
            tools:targetApi="34" />

    </application>

</manifest>

