<?xml version="1.0" encoding="utf-8"?>
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Search Action -->
    <item
        android:id="@+id/action_search"
        android:title="@string/menu_search"
        android:icon="@drawable/ic_search"
        app:showAsAction="ifRoom|collapseActionView"
        app:actionViewClass="androidx.appcompat.widget.SearchView" />

    <!-- Filter Action -->
    <item
        android:id="@+id/action_filter"
        android:title="@string/menu_filter"
        android:icon="@drawable/ic_filter"
        app:showAsAction="ifRoom">
        
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/filter_all"
                    android:title="@string/filter_all"
                    android:checked="true" />
                
                <item
                    android:id="@+id/filter_onboarding"
                    android:title="@string/filter_onboarding" />
                
                <item
                    android:id="@+id/filter_wild_encounter"
                    android:title="@string/filter_wild_encounter" />
                
                <item
                    android:id="@+id/filter_battle"
                    android:title="@string/filter_battle" />
                
                <item
                    android:id="@+id/filter_ai"
                    android:title="@string/filter_ai" />
                
                <item
                    android:id="@+id/filter_stress"
                    android:title="@string/filter_stress" />
            </group>
        </menu>
    </item>

    <!-- Sort Action -->
    <item
        android:id="@+id/action_sort"
        android:title="@string/menu_sort"
        android:icon="@drawable/ic_sort"
        app:showAsAction="never">
        
        <menu>
            <group android:checkableBehavior="single">
                <item
                    android:id="@+id/sort_name_asc"
                    android:title="@string/sort_name_asc"
                    android:checked="true" />
                
                <item
                    android:id="@+id/sort_name_desc"
                    android:title="@string/sort_name_desc" />
                
                <item
                    android:id="@+id/sort_priority_high"
                    android:title="@string/sort_priority_high" />
                
                <item
                    android:id="@+id/sort_duration_short"
                    android:title="@string/sort_duration_short" />
                
                <item
                    android:id="@+id/sort_duration_long"
                    android:title="@string/sort_duration_long" />
            </group>
        </menu>
    </item>

    <!-- Chat Navigation -->
    <item
        android:id="@+id/action_chat"
        android:title="@string/menu_chat"
        android:icon="@drawable/ic_chat"
        app:showAsAction="never" />

    <!-- Reports Navigation -->
    <item
        android:id="@+id/action_reports"
        android:title="@string/menu_reports"
        android:icon="@drawable/ic_report"
        app:showAsAction="never" />

    <!-- Run All Tests -->
    <item
        android:id="@+id/action_run_all"
        android:title="@string/menu_run_all_tests"
        android:icon="@drawable/ic_play"
        app:showAsAction="never" />

    <!-- Settings -->
    <item
        android:id="@+id/action_settings"
        android:title="@string/menu_settings"
        android:icon="@drawable/ic_settings"
        app:showAsAction="never" />

    <!-- About -->
    <item
        android:id="@+id/action_about"
        android:title="@string/menu_about"
        android:icon="@drawable/ic_help_circle"
        app:showAsAction="never" />

</menu>
